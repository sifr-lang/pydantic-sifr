from pydantic_sifr import (
    BaseModel,
    SerializationError,
    computed_field,
    field_serializer,
    model_serializer,
)
from sifr.json import JsonValue


class SerializerFailure(Error):
    message: str


class PlainModel(BaseModel):
    value: int64
    label: str


class Invoice(BaseModel):
    amount: int64
    note: str | None

    @field_serializer("amount")
    def serialize_amount(self, own value: int64) -> str:
        return "$" + str(value)

    @field_serializer("note", when_used="json-unless-none")
    @staticmethod
    def serialize_note(own value: str | None) -> str:
        if value is None:
            return "missing"
        return "note:" + value

    @computed_field(alias="display")
    def display_name(self) -> str:
        return "invoice"


class PolicyModel(BaseModel):
    always_value: str
    unless_none_value: str | None
    json_value: str
    json_unless_none_value: str | None

    @field_serializer("always_value")
    @staticmethod
    def serialize_always(own value: str) -> str:
        return "always:" + value

    @field_serializer("unless_none_value", when_used="unless-none")
    @staticmethod
    def serialize_unless_none(own value: str | None) -> str:
        if value is None:
            return "unexpected"
        return "unless:" + value

    @field_serializer("json_value", when_used="json")
    @staticmethod
    def serialize_json(own value: str) -> str:
        return "json:" + value

    @field_serializer("json_unless_none_value", when_used="json-unless-none")
    @staticmethod
    def serialize_json_unless_none(own value: str | None) -> str:
        if value is None:
            return "unexpected"
        return "json-unless:" + value


class Envelope:
    token: str


class Replaced(BaseModel):
    value: int64

    @model_serializer()
    def serialize_model(self) -> Envelope:
        return Envelope("value-" + str(self.value))


class SerializerContext:
    suffix: str


class Contextual(BaseModel):
    value: str

    @field_serializer("value")
    @classmethod
    def serialize_value(cls, own value: str, mut context: SerializerContext) -> str:
        return value + context.suffix


class Failing(BaseModel):
    value: str

    @field_serializer("value")
    @staticmethod
    def reject(own value: str) -> Result[str, SerializerFailure]:
        raise SerializerFailure("serializer rejected " + value)


def main() -> Result[None, SerializationError | RustPanicError]:
    try:
        zero: int = 0
        seven: int64 = 7
        expected_seven: int = 7
        plain: PlainModel = PlainModel(seven, "plain")
        plain_dump: dict[str, JsonValue] = plain.model_dump()
        plain_value: JsonValue | None = plain_dump.get("value")
        assert plain_value is not None
        if plain_value is not None:
            selected_plain_value: JsonValue = plain_value
            assert selected_plain_value.as_int() == expected_seven

        invoice: Invoice = Invoice(seven, None)
        structural: dict[str, JsonValue] = invoice.model_dump_options(
            None, None, True, False, False
        )
        amount: JsonValue | None = structural.get("amount")
        display: JsonValue | None = structural.get("display")
        assert amount is not None
        assert display is not None
        if amount is not None:
            selected_amount: JsonValue = amount
            assert selected_amount.as_str() == "$7"
        if display is not None:
            selected_display: JsonValue = display
            assert selected_display.as_str() == "invoice"
        assert structural.get("note") is not None

        json_bytes: bytes = invoice.model_dump_json()
        assert json_bytes == b'{"amount":"$7","note":null,"display_name":"invoice"}'

        policies: PolicyModel = PolicyModel("a", "u", "j", None)
        policy_dump: dict[str, JsonValue] = policies.model_dump()
        always_value: JsonValue | None = policy_dump.get("always_value")
        unless_none_value: JsonValue | None = policy_dump.get("unless_none_value")
        json_value: JsonValue | None = policy_dump.get("json_value")
        assert always_value is not None
        assert unless_none_value is not None
        assert json_value is not None
        if always_value is not None:
            selected_always: JsonValue = always_value
            assert selected_always.as_str() == "always:a"
        if unless_none_value is not None:
            selected_unless_none: JsonValue = unless_none_value
            assert selected_unless_none.as_str() == "unless:u"
        if json_value is not None:
            selected_json_value: JsonValue = json_value
            assert selected_json_value.as_str() == "j"
        policy_json: bytes = policies.model_dump_json()
        assert (
            policy_json
            == b'{"always_value":"always:a","unless_none_value":"unless:u","json_value":"json:j","json_unless_none_value":null}'
        )

        replacement: Replaced = Replaced(seven)
        replaced: dict[str, JsonValue] = replacement.model_dump()
        token: JsonValue | None = replaced.get("token")
        assert token is not None
        if token is not None:
            selected_token: JsonValue = token
            assert selected_token.as_str() == "value-7"

        context: SerializerContext = SerializerContext("!")
        contextual: Contextual = Contextual("checked")
        contextual_dump: dict[str, JsonValue] = contextual.model_dump_with_context(
            context, None, None, False, False, False
        )
        contextual_value: JsonValue | None = contextual_dump.get("value")
        assert contextual_value is not None
        if contextual_value is not None:
            selected_contextual_value: JsonValue = contextual_value
            assert selected_contextual_value.as_str() == "checked!"

        included: dict[str, JsonValue] = invoice.model_dump_options(
            ["amount"], None, False, False, False
        )
        assert len(included) == 1
        assert included.get("amount") is not None

        failed: bool = False
        try:
            rejected: dict[str, JsonValue] = Failing("bad").model_dump()
            assert len(rejected) == zero
        except SerializationError as error:
            failed = error.message.find("serializer rejected bad") is not None
        except RustPanicError as error:
            raise error
        assert failed
    except SerializationError as error:
        raise error
    except RustPanicError as error:
        raise error
    return None
