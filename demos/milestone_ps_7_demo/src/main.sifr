from enum import Enum
from pydantic_sifr import ValidationError
from pydantic_sifr import model_validate_json
from pydantic_sifr import verify_schema

# This demo is the public static-program integration receipt for PS7 sums.

class Status(Enum):
    READY = 1
    PAUSED = 2


class Cat:
    kind: str
    lives: int64


class Dog:
    kind: str
    bark: bool


@const_specialize("pydantic_sifr.schema_contract", "verify_schema")
@metadata("field", "status", "pydantic.enum.str", "ready")
@metadata("field", "status", "pydantic.enum.int", "9")
@metadata("field", "level", "pydantic.literal.int", "1")
@metadata("field", "level", "pydantic.literal.int", "2")
@metadata("field", "value", "pydantic.union.label", "integer")
@metadata("field", "value", "pydantic.union.label", "text")
@metadata("field", "pet", "pydantic.union.label", "cat")
@metadata("field", "pet", "pydantic.union.label", "dog")
@metadata("field", "pet", "pydantic.discriminator.field", "kind")
@metadata("field", "pet", "pydantic.discriminator.choice", "0")
@metadata("field", "pet", "pydantic.discriminator.tag.str", "cat")
@metadata("field", "pet", "pydantic.discriminator.choice", "1")
@metadata("field", "pet", "pydantic.discriminator.tag.str", "dog")
class Envelope:
    status: Status
    level: int64
    value: int64 | str
    pet: Cat | Dog


def main() -> Result[None, ValidationError | RustPanicError]:
    try:
        ready: Envelope = model_validate_json(
            b'{"status":"ready","level":2,"value":"hello","pet":{"kind":"cat","lives":9}}'
        )
        assert ready.status == Status.READY
        expected_level: int64 = 2
        assert ready.level == expected_level
        assert ready.value == "hello"

        paused: Envelope = model_validate_json(
            b'{"status":9,"level":1,"value":7,"pet":{"kind":"dog","bark":true}}'
        )
        assert paused.status == Status.PAUSED

        branch_seen: bool = False
        try:
            invalid: Envelope = model_validate_json(
                b'{"status":"ready","level":2,"value":[],"pet":{"kind":"cat","lives":9}}'
            )
            assert False
        except ValidationError as error:
            branch_seen = error.message.startswith(
                '{"errors":[{"code":"int_parsing","message":"Input must be a valid integer","expected":"int","location":["value","integer"]}'
            )
        except RustPanicError as error:
            raise error
        assert branch_seen
    except ValidationError as error:
        raise error
    except RustPanicError as error:
        raise error
    return None
