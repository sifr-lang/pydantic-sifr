from enum import Enum
from pydantic_sifr import AliasPath, BaseModel, Field, ValidationError
from pydantic_sifr import model_validate_json

# This demo is the public static-program integration receipt for PS7 sums.


class Status(Enum):
    READY = 1
    PAUSED = 2


class Cat(BaseModel):
    kind: str
    lives: int64


class Dog(BaseModel):
    kind: str
    bark: bool


class RecursiveNode(BaseModel):
    value: int64
    next: RecursiveNode | None


class Envelope(BaseModel):
    status: Status
    level: int64 = Field(literal_values=[1, 2])
    value: int64 | str = Field(union_labels=["integer", "text"])
    pet: Cat | Dog = Field(
        discriminator=AliasPath(["kind"]),
        discriminator_tags=["cat", "dog"],
    )


def main() -> Result[None, ValidationError | RustPanicError]:
    try:
        ready: Envelope = model_validate_json(
            b'{"status":1,"level":2,"value":"hello","pet":{"kind":"cat","lives":9}}'
        )
        assert ready.status == Status.READY
        expected_level: int64 = 2
        assert ready.level == expected_level
        assert ready.value == "hello"

        paused: Envelope = model_validate_json(
            b'{"status":2,"level":1,"value":7,"pet":{"kind":"dog","bark":true}}'
        )
        assert paused.status == Status.PAUSED

        recursive: RecursiveNode = model_validate_json(
            b'{"value":1,"next":{"value":2,"next":null}}'
        )
        expected_recursive_value: int64 = 1
        assert recursive.value == expected_recursive_value
        assert recursive.next is not None

        branch_seen: bool = False
        try:
            invalid: Envelope = model_validate_json(
                b'{"status":1,"level":2,"value":[],"pet":{"kind":"cat","lives":9}}'
            )
            assert False
        except ValidationError as error:
            branch_seen = error.message.startswith(
                '{"errors":[{"code":"int_parsing","message":"Input must be a valid integer","expected":"int","location":["value","integer"]}'
            )
        except RustPanicError as error:
            raise error
        assert branch_seen
    except ValidationError as error:
        raise error
    except RustPanicError as error:
        raise error
    return None
