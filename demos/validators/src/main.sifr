from pydantic_sifr import (
    BaseModel,
    ValidationError,
    field_validator,
    model_validator,
)
from sifr.meta import NoContext


class ValidatorFailure(Error):
    message: str


class RawUser:
    name: bool
    score: int64
    code: str


class NormalizedUserInput:
    name: bool
    score: int64
    code: str


class User(BaseModel):
    name: str
    score: int64
    code: int64

    @field_validator("name", mode="before")
    @classmethod
    def normalize_name(cls, own value: bool) -> str:
        return str(value)

    @field_validator("name", mode="after")
    @classmethod
    def check_name(cls, own value: str) -> Result[str, ValidatorFailure]:
        if len(value) == 0:
            raise ValidatorFailure("name is empty")
        return value

    @field_validator("code", mode="plain")
    @classmethod
    def parse_code(cls, own value: str) -> int64:
        if value == "reject":
            rejected: int64 = 41
            return rejected
        parsed: int64 = 42
        return parsed

    @model_validator(mode="before")
    @classmethod
    def normalize_input(cls, own value: RawUser) -> NormalizedUserInput:
        return NormalizedUserInput(value.name, value.score, value.code)

    @model_validator(mode="after")
    def check_score(own self) -> Result[Self, ValidatorFailure]:
        rejected: int64 = 41
        if self.code == rejected:
            raise ValidatorFailure("code is rejected")
        return self


class ValidationContext:
    seen: bool


class ContextValue(BaseModel):
    value: str

    @field_validator("value", mode="after")
    @classmethod
    def count(cls, own value: str, mut context: ValidationContext) -> str:
        context.seen = True
        return value


class FieldFailure(BaseModel):
    value: str

    @field_validator("value", mode="after")
    @classmethod
    def reject_empty(cls, own value: str) -> Result[str, ValidatorFailure]:
        if len(value) == 0:
            raise ValidatorFailure("field is empty")
        return value


class Pair(BaseModel):
    left: str
    right: str

    @field_validator("left", ["right"], mode="after")
    @classmethod
    def increment(cls, own value: str) -> str:
        return value + "!"


def main() -> Result[None, ValidationError | RustPanicError]:
    try:
        one: int64 = 1
        two: int64 = 2
        forty_two: int64 = 42
        context: NoContext = NoContext()
        from_json: User = User.model_validate_json_with_context(
            b'{"name":true,"score":1,"code":"input"}', context
        )
        assert from_json.name == "true"
        assert from_json.score == one
        assert from_json.code == forty_two
        raw: RawUser = RawUser(False, two, "structural")
        structural: User = User.model_validate_with_context(raw, context)
        assert structural.name == "false"
        assert structural.score == two
        assert structural.code == forty_two

        validation_context: ValidationContext = ValidationContext(False)
        contextual: ContextValue = ContextValue.model_validate_json_with_context(
            b'{"value":"context"}', validation_context
        )
        assert contextual.value == "context"
        assert validation_context.seen

        pair: Pair = Pair.model_validate_json_with_context(
            b'{"left":"a","right":"b"}', context
        )
        assert pair.left == "a!"
        assert pair.right == "b!"

        error_seen: bool = False
        try:
            invalid: User = User.model_validate_json_with_context(
                b'{"name":true,"score":1,"code":"reject"}', context
            )
            assert invalid.name == ""
        except ValidationError as error:
            has_message: bool = error.message.find("code is rejected") is not None
            has_context: bool = error.message.find('"context"') is not None
            has_root: bool = error.message.find('"location":[]') is not None
            error_seen = has_message and has_context and has_root
        except RustPanicError as error:
            raise error
        assert error_seen

        field_error_seen: bool = False
        try:
            invalid_field: FieldFailure = FieldFailure.model_validate_json_with_context(
                b'{"value":""}', context
            )
            assert invalid_field.value == "unreachable"
        except ValidationError as error:
            has_message: bool = error.message.find("field is empty") is not None
            has_context: bool = error.message.find('"context"') is not None
            has_field: bool = error.message.find('"location":["value"]') is not None
            field_error_seen = has_message and has_context and has_field
        except RustPanicError as error:
            raise error
        assert field_error_seen
    except ValidationError as error:
        raise error
    except RustPanicError as error:
        raise error
    return None
