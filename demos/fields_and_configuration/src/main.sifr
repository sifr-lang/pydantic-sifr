from enum import Enum
from typing import Annotated
from pydantic_sifr import AliasChoices, AliasPath, BaseModel, ConfigDict
from pydantic_sifr import Constraints, Field
from pydantic_sifr import MultiHostUrl, Pattern, SerializationError, SpecialValueError
from pydantic_sifr import Url, ValidationError, JsonSchemaError


def make_tags() -> list[str]:
    return []


class User(BaseModel):
    model_config = ConfigDict(
        extra="forbid",
        strict=True,
        populate_by_name=True,
    )
    id: int64 = Field(alias="user_id", gt=0)
    name: str = Field(min_length=1, max_length=100)
    active: bool = True
    tags: list[str] = Field(default_factory=make_tags)


class Simple(BaseModel):
    value: int64


class Status(Enum):
    READY = 1
    PAUSED = 2


class Cat(BaseModel):
    kind: str
    lives: int64


class Dog(BaseModel):
    kind: str
    bark: bool


class Node(BaseModel):
    value: int64
    next: Node | None = None


class ConfiguredModel(BaseModel):
    model_config = ConfigDict(extra="forbid", populate_by_name=True)
    path_value: int64 = Field(
        validation_alias=AliasChoices(
            [AliasPath(["payload", 0, "value"]), "path_value"]
        )
    )
    score: float = Field(gt=0.0, multiple_of=0.5)
    code: str = Field(min_length=2, max_length=8, pattern="^[a-z]+$")
    annotated_code: Annotated[str, Constraints(min_length=2)] = Field(max_length=8)
    data: bytes = Field(min_length=1, max_length=8)
    values: list[int64] = Field(min_length=1, max_length=3)
    level: int64 = Field(literal_values=[1, 2])
    flag: bool = Field(literal_values=[True])
    status: Status
    choice: int64 | str = Field(union_labels=["integer", "text"])
    pet: Cat | Dog = Field(
        discriminator=AliasPath(["kind"]),
        discriminator_tags=["cat", "dog"],
    )
    nested: User
    recursive: Node
    url: Url
    multi_host_url: MultiHostUrl
    compiled_pattern: Pattern
    optional_text: str | None = None
    hidden: str = Field(default="secret", exclude=True)


class GeneratedAliasModel(BaseModel):
    model_config = ConfigDict(alias_prefix="api_", populate_by_name=True)
    count: int64


class AliasChoiceModel(BaseModel):
    value: int64 = Field(validation_alias=AliasChoices(["first", "second"]))


class MergeOrderModel(BaseModel):
    value: Annotated[str, Constraints(min_length=2)] = Field(min_length=3)


class SeparateAliasModel(BaseModel):
    value: int64 = Field(
        validation_alias=AliasPath(["input", "value"]),
        serialization_alias="output_value",
    )


class ExcludedModel(BaseModel):
    visible: str
    hidden: str = Field(default="secret", exclude=True)


class SchemaModel(BaseModel):
    score: float = Field(gt=0.0, multiple_of=0.5)
    code: str = Field(
        min_length=2,
        max_length=8,
        pattern="^[a-z]+$",
        title="Code",
        description="Lowercase code",
        examples=["ok"],
        json_schema_extra={"x-note": "selected"},
    )
    data: bytes = Field(min_length=1, max_length=8)
    values: list[int64] = Field(min_length=1, max_length=3)


def main() -> Result[
    None,
    ValidationError
    | SerializationError
    | SpecialValueError
    | JsonSchemaError
    | ParseError
    | RustPanicError,
]:
    identifier: int64 = 7
    user: User = User(identifier, "Ada")
    assert user.id == identifier
    assert user.name == "Ada"
    assert user.active
    assert user.tags == []
    try:
        simple: Simple = Simple.model_validate_json(b'{"value":1}')
        expected_simple: int64 = 1
        assert simple.value == expected_simple
        validated: User = User.model_validate_json(b'{"user_id":8,"name":"Lin"}')
        expected_validated: int64 = 8
        assert validated.id == expected_validated
        assert validated.active
        assert validated.tags == []
        populated: User = User.model_validate_json(b'{"id":9,"name":"ByName"}')
        expected_populated: int64 = 9
        assert populated.id == expected_populated
        strict_error_seen: bool = False
        try:
            invalid_strict: User = User.model_validate_json(
                b'{"user_id":"8","name":"Strict"}'
            )
            assert invalid_strict.id != expected_validated
        except ValidationError:
            strict_error_seen = True
        except RustPanicError as error:
            raise error
        assert strict_error_seen
        extra_error_seen: bool = False
        try:
            invalid_extra: User = User.model_validate_json(
                b'{"user_id":8,"name":"Extra","unknown":true}'
            )
            assert invalid_extra.id != expected_validated
        except ValidationError:
            extra_error_seen = True
        except RustPanicError as error:
            raise error
        assert extra_error_seen
        configured: ConfiguredModel = ConfiguredModel.model_validate_json(
            b'{"payload":[{"value":4}],"score":1.5,"code":"valid","annotated_code":"merged","data":"x","values":[1,2],"level":2,"flag":true,"status":1,"choice":"text","pet":{"kind":"cat","lives":9},"nested":{"user_id":3,"name":"Nested"},"recursive":{"value":1,"next":{"value":2}},"url":"https://EXAMPLE.com/a/../b","multi_host_url":"postgres://user:pass@one.example:5432,TWO.example:5433/db","compiled_pattern":"^abc$"}'
        )
        expected_path: int64 = 4
        assert configured.path_value == expected_path
        url_text: str = configured.url.text()
        multi_host_url_text: str = configured.multi_host_url.text()
        pattern_source: str = configured.compiled_pattern.source()
        pattern_flags: uint8 = configured.compiled_pattern.flags()
        expected_flags: uint8 = 0
        assert url_text == "https://example.com/b"
        assert (
            multi_host_url_text
            == "postgres://user:pass@one.example:5432,two.example:5433/db"
        )
        assert pattern_source == "^abc$"
        assert pattern_flags == expected_flags
        branch_error_seen: bool = False
        try:
            invalid_choice: ConfiguredModel = ConfiguredModel.model_validate_json(
                b'{"payload":[{"value":4}],"score":1.5,"code":"valid","annotated_code":"merged","data":"x","values":[1,2],"level":2,"flag":true,"status":1,"choice":[],"pet":{"kind":"cat","lives":9},"nested":{"user_id":3,"name":"Nested"},"recursive":{"value":1},"url":"https://example.com","multi_host_url":"postgres://one.example/db","compiled_pattern":"^abc$"}'
            )
            assert invalid_choice.path_value != expected_path
        except ValidationError as error:
            branch_error_seen = error.message.startswith(
                '{"errors":[{"code":"int_parsing","message":"Input must be a valid integer","expected":"int","location":["choice","integer"]}'
            )
        except RustPanicError as error:
            raise error
        assert branch_error_seen
        first_alias: AliasChoiceModel = AliasChoiceModel.model_validate_json(
            b'{"first":1,"second":2}'
        )
        expected_first_alias: int64 = 1
        assert first_alias.value == expected_first_alias
        fallback_alias: AliasChoiceModel = AliasChoiceModel.model_validate_json(
            b'{"second":2}'
        )
        expected_fallback_alias: int64 = 2
        assert fallback_alias.value == expected_fallback_alias
        merged_field: MergeOrderModel = MergeOrderModel.model_validate_json(
            b'{"value":"abc"}'
        )
        assert merged_field.value == "abc"
        merge_error_seen: bool = False
        try:
            invalid_merge: MergeOrderModel = MergeOrderModel.model_validate_json(
                b'{"value":"ab"}'
            )
            assert invalid_merge.value != "ab"
        except ValidationError:
            merge_error_seen = True
        except RustPanicError as error:
            raise error
        assert merge_error_seen
        separate_alias: SeparateAliasModel = SeparateAliasModel.model_validate_json(
            b'{"input":{"value":3}}'
        )
        expected_separate_alias: int64 = 3
        assert separate_alias.value == expected_separate_alias
        excluded: ExcludedModel = ExcludedModel("shown")
        dumped: bytes = excluded.model_dump_json()
        dumped_text: str = dumped.decode()
        assert '"hidden"' not in dumped_text
        schema_model: SchemaModel = SchemaModel(1.5, "valid", b"x", [identifier])
        schema_bytes: bytes = SchemaModel.model_json_schema()
        schema_text: str = schema_bytes.decode()
        assert '"exclusiveMinimum":0.0' in schema_text
        assert '"multipleOf":0.5' in schema_text
        assert '"pattern":"^[a-z]+$"' in schema_text
        assert '"title":"Code"' in schema_text
        assert '"description":"Lowercase code"' in schema_text
        assert '"examples":["ok"]' in schema_text
        assert '"x-note":"selected"' in schema_text
        assert '"minItems":1' in schema_text
        assert '"maxItems":3' in schema_text
        generated: GeneratedAliasModel = GeneratedAliasModel.model_validate_json(
            b'{"api_count":6}'
        )
        expected_generated: int64 = 6
        assert generated.count == expected_generated
    except ValidationError as error:
        raise error
    except SpecialValueError as error:
        raise error
    except SerializationError as error:
        raise error
    except JsonSchemaError as error:
        raise error
    except ParseError as error:
        raise error
    except RustPanicError as error:
        raise error
    return None
