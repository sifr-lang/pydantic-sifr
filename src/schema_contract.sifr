from .errors import SchemaIssue, SchemaIssueArgs


SCHEMA_PROGRAM_FORMAT_VERSION: int = 1
STRUCTURAL_CONTRACT_VERSION: int = 1
STRUCTURAL_CALL_VERSION: int = 1
CALLBACK_ABI_VERSION: int = 1


class ShapeMetadata:
    key: str
    value_type: str
    value: str


class ShapeField:
    name: str
    type: ShapeNode
    required: bool
    default: str | None
    metadata: list[ShapeMetadata]


class ShapeVariant:
    name: str
    value: int | None
    metadata: list[ShapeMetadata]


class ShapeNode:
    kind: str
    name: str
    identity: str
    element: ShapeNode | None
    key: ShapeNode | None
    value: ShapeNode | None
    members: list[ShapeNode]
    type_arguments: list[ShapeNode]
    fields: list[ShapeField]
    metadata: list[ShapeMetadata]
    variants: list[ShapeVariant]
    inner: ShapeNode | None


class ShapeInput:
    canonical_identity: str
    root: ShapeNode


class SchemaNodePayload:
    kind: str
    children: list[int]
    definition: str | None
    reference: str | None
    error_code: str | None
    error_message: str | None


class SchemaProgramPayload:
    schema_program_version: int
    structural_contract_version: int
    structural_call_version: int
    callback_abi_version: int
    feature_bitmap: int
    canonical_shape_identity: str
    root: int
    nodes: list[SchemaNodePayload]


class SchemaOutcome:
    status: str
    value: SchemaProgramPayload | None
    issues: list[SchemaIssue]


class ErrorOverrideResult:
    code: str | None
    message: str | None
    issue: str | None


class NodeBuildResult:
    nodes: list[SchemaNodePayload]
    root: int
    issue: str | None


@const_eval
def schema_failure(problem: str) -> SchemaOutcome:
    issue: SchemaIssue = SchemaIssue(
        "pydantic_sifr.schema_contract",
        "schema_invalid",
        "fatal",
        SchemaIssueArgs(problem),
        [],
    )
    return SchemaOutcome("failed", None, [issue])


@const_eval
def primitive_kind(name: str) -> str:
    if name == "int" or name == "bigint":
        return "int"
    if name == "float":
        return "float"
    if name == "bool":
        return "bool"
    if name == "str":
        return "str"
    if name == "bytes":
        return "bytes"
    if name == "None":
        return "none"
    if name == "decimal" or name == "bigdecimal":
        return "decimal"
    return ""


@const_eval
def built_in_message(code: str) -> str:
    if code == "json_invalid":
        return "Invalid JSON: {error}"
    if code == "schema_invalid":
        return "Invalid schema: {error}"
    if code == "input_limit_exceeded":
        return "Input limit exceeded: {limit}"
    if code == "internal_program_load":
        return "Schema program could not be loaded"
    return ""


@const_eval
def error_override(metadata: list[ShapeMetadata]) -> ErrorOverrideResult:
    built_in: str = ""
    package: str = ""
    code: str = ""
    message: str = ""
    has_built_in: bool = False
    has_package: bool = False
    has_code: bool = False
    has_message: bool = False
    for item in metadata:
        relevant: bool = (
            item.key == "pydantic.error.builtin"
            or item.key == "pydantic.error.package"
            or item.key == "pydantic.error.code"
            or item.key == "pydantic.error.message"
        )
        if relevant and item.value_type != "str":
            return ErrorOverrideResult(
                None, None, "error override values must be strings"
            )
        if item.key == "pydantic.error.builtin":
            if has_built_in:
                return ErrorOverrideResult(None, None, "duplicate built-in error code")
            built_in = item.value
            has_built_in = True
        elif item.key == "pydantic.error.package":
            if has_package:
                return ErrorOverrideResult(None, None, "duplicate custom error package")
            package = item.value
            has_package = True
        elif item.key == "pydantic.error.code":
            if has_code:
                return ErrorOverrideResult(None, None, "duplicate custom error code")
            code = item.value
            has_code = True
        elif item.key == "pydantic.error.message":
            if has_message:
                return ErrorOverrideResult(None, None, "duplicate error message")
            message = item.value
            has_message = True
    if has_built_in:
        if has_package or has_code:
            return ErrorOverrideResult(
                None, None, "error override mixes built-in and custom codes"
            )
        expected: str = built_in_message(built_in)
        if expected == "":
            return ErrorOverrideResult(None, None, "unknown built-in error code")
        if not has_message:
            return ErrorOverrideResult(
                None, None, "built-in error message cannot change"
            )
        if message != expected:
            return ErrorOverrideResult(
                None, None, "built-in error message cannot change"
            )
        return ErrorOverrideResult(built_in, message, None)
    if has_package or has_code or has_message:
        if not has_package or not has_code or not has_message:
            return ErrorOverrideResult(
                None, None, "custom error declaration is incomplete"
            )
        if len(package) == 0 or len(code) == 0 or len(message) == 0:
            return ErrorOverrideResult(
                None, None, "custom error declaration contains an empty value"
            )
        return ErrorOverrideResult(package + "." + code, message, None)
    return ErrorOverrideResult(None, None, None)


@const_eval
def rebase_nodes(
    nodes: list[SchemaNodePayload], offset: int
) -> list[SchemaNodePayload]:
    output: list[SchemaNodePayload] = []
    for node in nodes:
        children: list[int] = []
        for child in node.children:
            children.append(child + offset)
        output.append(
            SchemaNodePayload(
                node.kind,
                children,
                node.definition,
                node.reference,
                node.error_code,
                node.error_message,
            )
        )
    return output


@const_eval
def build_node(node: ShapeNode, inherited: list[ShapeMetadata]) -> NodeBuildResult:
    override: ErrorOverrideResult = error_override(inherited)
    if override.issue is not None:
        return NodeBuildResult([], 0, override.issue)
    if node.kind == "primitive" or node.kind == "fixed_integer":
        kind: str = "int"
        if node.kind == "primitive":
            kind = primitive_kind(node.name)
        if kind == "":
            return NodeBuildResult([], 0, "unsupported structural primitive")
        leaf: SchemaNodePayload = SchemaNodePayload(
            kind,
            [],
            None,
            None,
            override.code,
            override.message,
        )
        return NodeBuildResult([leaf], 0, None)
    if node.kind == "recursive_reference":
        reference: SchemaNodePayload = SchemaNodePayload(
            "definition-ref",
            [],
            None,
            node.identity,
            override.code,
            override.message,
        )
        return NodeBuildResult([reference], 0, None)
    if node.kind == "list" or node.kind == "set" or node.kind == "optional":
        element: ShapeNode | None = node.element
        if element is None:
            return NodeBuildResult([], 0, "unary schema node has no element")
        built_element: NodeBuildResult = build_node(element, [])
        if built_element.issue is not None:
            return built_element
        unary_kind: str = "list"
        if node.kind == "set":
            unary_kind = "set"
        if node.kind == "optional":
            unary_kind = "nullable"
        unary: SchemaNodePayload = SchemaNodePayload(
            unary_kind,
            [built_element.root],
            None,
            None,
            override.code,
            override.message,
        )
        root: int = len(built_element.nodes)
        return NodeBuildResult(built_element.nodes + [unary], root, None)
    if node.kind == "dictionary":
        key: ShapeNode | None = node.key
        value: ShapeNode | None = node.value
        if key is None or value is None:
            return NodeBuildResult([], 0, "mapping schema node is incomplete")
        built_key: NodeBuildResult = build_node(key, [])
        if built_key.issue is not None:
            return built_key
        built_value: NodeBuildResult = build_node(value, [])
        if built_value.issue is not None:
            return built_value
        value_offset: int = len(built_key.nodes)
        nodes: list[SchemaNodePayload] = built_key.nodes + rebase_nodes(
            built_value.nodes,
            value_offset,
        )
        mapping: SchemaNodePayload = SchemaNodePayload(
            "dict",
            [built_key.root, built_value.root + value_offset],
            None,
            None,
            override.code,
            override.message,
        )
        root: int = len(nodes)
        return NodeBuildResult(nodes + [mapping], root, None)
    if node.kind == "tuple" or node.kind == "union":
        member_nodes: list[SchemaNodePayload] = []
        member_roots: list[int] = []
        for member in node.members:
            built_member: NodeBuildResult = build_node(member, [])
            if built_member.issue is not None:
                return built_member
            offset: int = len(member_nodes)
            member_nodes = member_nodes + rebase_nodes(built_member.nodes, offset)
            member_roots.append(built_member.root + offset)
        sequence: SchemaNodePayload = SchemaNodePayload(
            node.kind,
            member_roots,
            None,
            None,
            override.code,
            override.message,
        )
        root: int = len(member_nodes)
        return NodeBuildResult(member_nodes + [sequence], root, None)
    if node.kind == "nominal":
        override = error_override(inherited + node.metadata)
        if override.issue is not None:
            return NodeBuildResult([], 0, override.issue)
        field_nodes: list[SchemaNodePayload] = []
        field_roots: list[int] = []
        for field in node.fields:
            built_field: NodeBuildResult = build_node(field.type, field.metadata)
            if built_field.issue is not None:
                return built_field
            offset: int = len(field_nodes)
            field_nodes = field_nodes + rebase_nodes(built_field.nodes, offset)
            field_roots.append(built_field.root + offset)
        model: SchemaNodePayload = SchemaNodePayload(
            "model",
            field_roots,
            node.identity,
            None,
            override.code,
            override.message,
        )
        root: int = len(field_nodes)
        return NodeBuildResult(field_nodes + [model], root, None)
    if node.kind == "enum":
        override = error_override(inherited + node.metadata)
        if override.issue is not None:
            return NodeBuildResult([], 0, override.issue)
        enumeration: SchemaNodePayload = SchemaNodePayload(
            "enum",
            [],
            node.identity,
            None,
            override.code,
            override.message,
        )
        return NodeBuildResult([enumeration], 0, None)
    if node.kind == "newtype":
        override = error_override(inherited + node.metadata)
        if override.issue is not None:
            return NodeBuildResult([], 0, override.issue)
        inner: ShapeNode | None = node.inner
        if inner is None:
            return NodeBuildResult([], 0, "newtype schema node has no inner type")
        built_inner: NodeBuildResult = build_node(inner, [])
        if built_inner.issue is not None:
            return built_inner
        wrapper: SchemaNodePayload = SchemaNodePayload(
            "model",
            [built_inner.root],
            node.identity,
            None,
            override.code,
            override.message,
        )
        root: int = len(built_inner.nodes)
        return NodeBuildResult(built_inner.nodes + [wrapper], root, None)
    return NodeBuildResult([], 0, "structural shape cannot form a schema program")


@const_eval
def expected_arity(kind: str) -> int:
    if kind == "list" or kind == "set" or kind == "nullable":
        return 1
    if kind == "dict":
        return 2
    if kind == "model" or kind == "tuple" or kind == "union":
        return -1
    return 0


@const_eval
def verify_nodes(nodes: list[SchemaNodePayload], root: int) -> str | None:
    count: int = len(nodes)
    if count == 0:
        return "schema program has no nodes"
    if count > 4096:
        return "schema program exceeds the static node limit"
    if root < 0 or root >= count:
        return "schema root is out of range"
    for node in nodes:
        arity: int = expected_arity(node.kind)
        if arity >= 0 and len(node.children) != arity:
            return "schema node has invalid child arity"
        for child in node.children:
            if child < 0 or child >= count:
                return "schema child index is out of range"
        if node.reference is not None and node.kind != "definition-ref":
            return "non-reference schema node has a reference"
        if node.kind == "definition-ref" and node.reference is None:
            return "definition reference has no identity"
        if node.error_code is None and node.error_message is not None:
            return "schema node has an error message without a code"
        if node.error_code is not None and node.error_message is None:
            return "schema node has an error code without a message"
    for left in nodes:
        if left.definition is not None:
            matches: int = 0
            for right in nodes:
                if right.definition == left.definition:
                    matches += 1
            if matches != 1:
                return "schema program has duplicate definition identities"
    for reference in nodes:
        if reference.reference is not None:
            found: bool = False
            for target in nodes:
                if target.definition == reference.reference:
                    found = True
            if not found:
                return "schema program has a dangling definition reference"
    return None


@const_eval
@metadata("sifr.meta.issue_template", ("schema_invalid", ["problem"]))
def verify_schema(shape: ShapeInput) -> SchemaOutcome:
    built: NodeBuildResult = build_node(shape.root, [])
    build_issue: str | None = built.issue
    if build_issue is not None:
        return schema_failure(build_issue)
    problem: str | None = verify_nodes(built.nodes, built.root)
    if problem is not None:
        return schema_failure(problem)
    program: SchemaProgramPayload = SchemaProgramPayload(
        1,
        1,
        1,
        1,
        0,
        shape.canonical_identity,
        built.root,
        built.nodes,
    )
    return SchemaOutcome("produced", program, [])
