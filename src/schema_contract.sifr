from .errors import SchemaIssue, SchemaIssueArgs


SCHEMA_PROGRAM_FORMAT_VERSION: int = 1
STRUCTURAL_CONTRACT_VERSION: int = 1
STRUCTURAL_CALL_VERSION: int = 1
CALLBACK_ABI_VERSION: int = 1


class ShapeMetadata:
    key: str
    value_type: str
    value: str


class ShapeField:
    name: str
    type: ShapeNode
    required: bool
    default: bool | int | float | str | bytes | None
    metadata: list[ShapeMetadata]


class ShapeVariant:
    name: str
    value: int | None
    metadata: list[ShapeMetadata]


class ShapeNode:
    kind: str
    name: str
    identity: str
    element: ShapeNode | None
    key: ShapeNode | None
    value: ShapeNode | None
    members: list[ShapeNode]
    type_arguments: list[ShapeNode]
    fields: list[ShapeField]
    metadata: list[ShapeMetadata]
    variants: list[ShapeVariant]
    inner: ShapeNode | None


class ShapeInput:
    canonical_identity: str
    root: ShapeNode


class SchemaAliasSegmentPayload:
    kind: str
    name: str | None
    index: str | None


class SchemaFieldPayload:
    name: str
    node: int
    required: bool
    default: bool | int | float | str | bytes | None
    validation_alias: list[SchemaAliasSegmentPayload]


class SchemaModelPayload:
    name: str
    identity: str
    fields: list[SchemaFieldPayload]
    extra: str
    populate_by_name: bool
    location_by_alias: bool


class SchemaIntegerConstraintsPayload:
    greater_than: str | None
    greater_or_equal: str | None
    less_than: str | None
    less_or_equal: str | None
    multiple_of: str | None


class SchemaStringConstraintsPayload:
    min_length: str | None
    max_length: str | None
    strip_whitespace: bool
    to_lower: bool
    to_upper: bool
    ascii_only: bool


class SchemaNodePayload:
    kind: str
    children: list[int]
    definition: str | None
    reference: str | None
    error_code: str | None
    error_message: str | None
    model: SchemaModelPayload | None
    integer_target: str | None
    integer_constraints: SchemaIntegerConstraintsPayload | None
    string_constraints: SchemaStringConstraintsPayload | None
    metadata: list[ShapeMetadata]
    variants: list[ShapeVariant]


class SchemaProgramPayload:
    schema_program_version: int
    structural_contract_version: int
    structural_call_version: int
    callback_abi_version: int
    feature_bitmap: int
    canonical_shape_identity: str
    root: int
    nodes: list[SchemaNodePayload]


class SchemaOutcome:
    status: str
    value: SchemaProgramPayload | None
    issues: list[SchemaIssue]


class ErrorOverrideResult:
    code: str | None
    message: str | None
    issue: str | None


class NodeBuildResult:
    nodes: list[SchemaNodePayload]
    root: int
    issue: str | None


class FieldRules:
    validation_alias: list[SchemaAliasSegmentPayload]
    integer_constraints: SchemaIntegerConstraintsPayload
    string_constraints: SchemaStringConstraintsPayload
    issue: str | None


class ModelRules:
    extra: str
    populate_by_name: bool
    location_by_alias: bool
    issue: str | None


@const_eval
def is_literal_key(key: str) -> bool:
    return (
        key == "pydantic.literal.none"
        or key == "pydantic.literal.bool"
        or key == "pydantic.literal.int"
        or key == "pydantic.literal.str"
        or key == "pydantic.literal.bytes"
    )


@const_eval
def sum_kind(base: str, metadata: list[ShapeMetadata]) -> str:
    for item in metadata:
        if is_literal_key(item.key):
            return "literal"
        if base == "union" and (
            item.key == "pydantic.discriminator.field"
            or item.key == "pydantic.discriminator.index"
        ):
            return "tagged-union"
    return base + ""


@const_eval
def schema_failure(problem: str) -> SchemaOutcome:
    issue: SchemaIssue = SchemaIssue(
        "pydantic_sifr.schema_contract",
        "schema_invalid",
        "fatal",
        SchemaIssueArgs(problem),
        [],
    )
    return SchemaOutcome("failed", None, [issue])


@const_eval
def primitive_kind(name: str) -> str:
    if name == "int" or name == "bigint":
        return "int"
    if name == "float":
        return "float"
    if name == "bool":
        return "bool"
    if name == "str":
        return "str"
    if name == "bytes":
        return "bytes"
    if name == "None":
        return "none"
    if name == "decimal" or name == "bigdecimal":
        return "decimal"
    return ""


@const_eval
def built_in_message(code: str) -> str:
    if code == "json_invalid":
        return "Invalid JSON: {error}"
    if code == "schema_invalid":
        return "Invalid schema: {error}"
    if code == "input_limit_exceeded":
        return "Input limit exceeded: {limit}"
    if code == "internal_program_load":
        return "Schema program could not be loaded"
    return ""


@const_eval
def error_override(metadata: list[ShapeMetadata]) -> ErrorOverrideResult:
    built_in: str = ""
    package: str = ""
    code: str = ""
    message: str = ""
    has_built_in: bool = False
    has_package: bool = False
    has_code: bool = False
    has_message: bool = False
    for item in metadata:
        raw: str = item.value
        relevant: bool = (
            item.key == "pydantic.error.builtin"
            or item.key == "pydantic.error.package"
            or item.key == "pydantic.error.code"
            or item.key == "pydantic.error.message"
        )
        text: str = ""
        if relevant:
            text = raw
        if item.key == "pydantic.error.builtin":
            if has_built_in:
                return ErrorOverrideResult(None, None, "duplicate built-in error code")
            built_in = text
            has_built_in = True
        elif item.key == "pydantic.error.package":
            if has_package:
                return ErrorOverrideResult(None, None, "duplicate custom error package")
            package = text
            has_package = True
        elif item.key == "pydantic.error.code":
            if has_code:
                return ErrorOverrideResult(None, None, "duplicate custom error code")
            code = text
            has_code = True
        elif item.key == "pydantic.error.message":
            if has_message:
                return ErrorOverrideResult(None, None, "duplicate error message")
            message = text
            has_message = True
    if has_built_in:
        if has_package or has_code:
            return ErrorOverrideResult(
                None, None, "error override mixes built-in and custom codes"
            )
        expected: str = built_in_message(built_in)
        if expected == "":
            return ErrorOverrideResult(None, None, "unknown built-in error code")
        if not has_message:
            return ErrorOverrideResult(
                None, None, "built-in error message cannot change"
            )
        if message != expected:
            return ErrorOverrideResult(
                None, None, "built-in error message cannot change"
            )
        return ErrorOverrideResult(built_in, message, None)
    if has_package or has_code or has_message:
        if not has_package or not has_code or not has_message:
            return ErrorOverrideResult(
                None, None, "custom error declaration is incomplete"
            )
        if len(package) == 0 or len(code) == 0 or len(message) == 0:
            return ErrorOverrideResult(
                None, None, "custom error declaration contains an empty value"
            )
        return ErrorOverrideResult(package + "." + code, message, None)
    return ErrorOverrideResult(None, None, None)


@const_eval
def field_rules(metadata: list[ShapeMetadata]) -> FieldRules:
    aliases: list[SchemaAliasSegmentPayload] = []
    greater_than: str | None = None
    greater_or_equal: str | None = None
    less_than: str | None = None
    less_or_equal: str | None = None
    multiple_of: str | None = None
    min_length: str | None = None
    max_length: str | None = None
    strip_whitespace: bool = False
    to_lower: bool = False
    to_upper: bool = False
    ascii_only: bool = False
    for item in metadata:
        raw: str = item.value
        if item.key == "pydantic.alias.field":
            aliases.append(SchemaAliasSegmentPayload("field", raw, None))
        elif item.key == "pydantic.alias.index":
            aliases.append(SchemaAliasSegmentPayload("index", None, raw))
        elif item.key == "pydantic.gt":
            greater_than = raw
        elif item.key == "pydantic.ge":
            greater_or_equal = raw
        elif item.key == "pydantic.lt":
            less_than = raw
        elif item.key == "pydantic.le":
            less_or_equal = raw
        elif item.key == "pydantic.multiple_of":
            if raw == "0" or raw == "-0":
                return FieldRules(
                    [],
                    SchemaIntegerConstraintsPayload(None, None, None, None, None),
                    SchemaStringConstraintsPayload(
                        None, None, False, False, False, False
                    ),
                    "multiple_of must be a nonzero integer",
                )
            multiple_of = raw
        elif item.key == "pydantic.min_length":
            min_length = raw
        elif item.key == "pydantic.max_length":
            max_length = raw
        elif item.key == "pydantic.strip_whitespace":
            if raw != "true" and raw != "false":
                return FieldRules(
                    [],
                    SchemaIntegerConstraintsPayload(None, None, None, None, None),
                    SchemaStringConstraintsPayload(
                        None, None, False, False, False, False
                    ),
                    "strip_whitespace must be a boolean",
                )
            strip_whitespace = raw == "true"
        elif item.key == "pydantic.to_lower":
            if raw != "true" and raw != "false":
                return FieldRules(
                    [],
                    SchemaIntegerConstraintsPayload(None, None, None, None, None),
                    SchemaStringConstraintsPayload(
                        None, None, False, False, False, False
                    ),
                    "to_lower must be a boolean",
                )
            to_lower = raw == "true"
        elif item.key == "pydantic.to_upper":
            if raw != "true" and raw != "false":
                return FieldRules(
                    [],
                    SchemaIntegerConstraintsPayload(None, None, None, None, None),
                    SchemaStringConstraintsPayload(
                        None, None, False, False, False, False
                    ),
                    "to_upper must be a boolean",
                )
            to_upper = raw == "true"
        elif item.key == "pydantic.ascii_only":
            if raw != "true" and raw != "false":
                return FieldRules(
                    [],
                    SchemaIntegerConstraintsPayload(None, None, None, None, None),
                    SchemaStringConstraintsPayload(
                        None, None, False, False, False, False
                    ),
                    "ascii_only must be a boolean",
                )
            ascii_only = raw == "true"
    if to_lower and to_upper:
        return FieldRules(
            [],
            SchemaIntegerConstraintsPayload(None, None, None, None, None),
            SchemaStringConstraintsPayload(None, None, False, False, False, False),
            "to_lower and to_upper cannot both be enabled",
        )
    return FieldRules(
        aliases,
        SchemaIntegerConstraintsPayload(
            greater_than, greater_or_equal, less_than, less_or_equal, multiple_of
        ),
        SchemaStringConstraintsPayload(
            min_length, max_length, strip_whitespace, to_lower, to_upper, ascii_only
        ),
        None,
    )


@const_eval
def model_rules(metadata: list[ShapeMetadata]) -> ModelRules:
    extra: str = "ignore"
    populate_by_name: bool = False
    location_by_alias: bool = True
    for item in metadata:
        raw: str = item.value
        if item.key == "pydantic.extra":
            if raw != "ignore" and raw != "forbid":
                return ModelRules(
                    extra,
                    populate_by_name,
                    location_by_alias,
                    "extra policy must be ignore or forbid",
                )
            extra = raw
        elif item.key == "pydantic.populate_by_name":
            if raw != "true" and raw != "false":
                return ModelRules(
                    extra,
                    populate_by_name,
                    location_by_alias,
                    "populate_by_name must be a boolean",
                )
            populate_by_name = raw == "true"
        elif item.key == "pydantic.location_by_alias":
            if raw != "true" and raw != "false":
                return ModelRules(
                    extra,
                    populate_by_name,
                    location_by_alias,
                    "location_by_alias must be a boolean",
                )
            location_by_alias = raw == "true"
    return ModelRules(extra, populate_by_name, location_by_alias, None)


@const_eval
def rebase_nodes(
    nodes: list[SchemaNodePayload], offset: int
) -> list[SchemaNodePayload]:
    output: list[SchemaNodePayload] = []
    for node in nodes:
        children: list[int] = []
        for child in node.children:
            children.append(child + offset)
        model: SchemaModelPayload | None = None
        node_model: SchemaModelPayload | None = node.model
        if node_model is None:
            model = None
        else:
            current_model: SchemaModelPayload = node_model
            fields: list[SchemaFieldPayload] = []
            for field in current_model.fields:
                fields.append(
                    SchemaFieldPayload(
                        field.name,
                        field.node + offset,
                        field.required,
                        field.default,
                        field.validation_alias,
                    )
                )
            model = SchemaModelPayload(
                current_model.name,
                current_model.identity,
                fields,
                current_model.extra,
                current_model.populate_by_name,
                current_model.location_by_alias,
            )
        output.append(
            SchemaNodePayload(
                node.kind,
                children,
                node.definition,
                node.reference,
                node.error_code,
                node.error_message,
                model,
                node.integer_target,
                node.integer_constraints,
                node.string_constraints,
                node.metadata,
                node.variants,
            )
        )
    return output


@const_eval
def build_node(node: ShapeNode, inherited: list[ShapeMetadata]) -> NodeBuildResult:
    override: ErrorOverrideResult = error_override(inherited)
    if override.issue is not None:
        return NodeBuildResult([], 0, override.issue)
    rules: FieldRules = field_rules(inherited)
    if rules.issue is not None:
        return NodeBuildResult([], 0, rules.issue)
    if node.kind == "primitive" or node.kind == "fixed_integer":
        kind: str = "int"
        if node.kind == "primitive":
            kind = primitive_kind(node.name)
        if kind == "":
            return NodeBuildResult([], 0, "unsupported structural primitive")
        integer_target: str | None = None
        if kind == "int":
            if node.kind == "fixed_integer":
                integer_target = node.name
            else:
                integer_target = "int"
        leaf: SchemaNodePayload = SchemaNodePayload(
            sum_kind(kind, inherited),
            [],
            None,
            None,
            override.code,
            override.message,
            None,
            integer_target,
            rules.integer_constraints,
            rules.string_constraints,
            inherited,
            [],
        )
        return NodeBuildResult([leaf], 0, None)
    if node.kind == "recursive_reference":
        reference: SchemaNodePayload = SchemaNodePayload(
            "definition-ref",
            [],
            None,
            node.identity,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            inherited,
            [],
        )
        return NodeBuildResult([reference], 0, None)
    if node.kind == "list" or node.kind == "set" or node.kind == "optional":
        element: ShapeNode | None = node.element
        if element is None:
            return NodeBuildResult([], 0, "unary schema node has no element")
        built_element: NodeBuildResult = build_node(element, [])
        if built_element.issue is not None:
            return built_element
        unary_kind: str = "list"
        if node.kind == "set":
            unary_kind = "set"
        if node.kind == "optional":
            unary_kind = "nullable"
        unary: SchemaNodePayload = SchemaNodePayload(
            sum_kind(unary_kind, inherited),
            [built_element.root],
            None,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            inherited,
            [],
        )
        root: int = len(built_element.nodes)
        return NodeBuildResult(built_element.nodes + [unary], root, None)
    if node.kind == "dictionary":
        key: ShapeNode | None = node.key
        value: ShapeNode | None = node.value
        if key is None or value is None:
            return NodeBuildResult([], 0, "mapping schema node is incomplete")
        built_key: NodeBuildResult = build_node(key, [])
        if built_key.issue is not None:
            return built_key
        built_value: NodeBuildResult = build_node(value, [])
        if built_value.issue is not None:
            return built_value
        value_offset: int = len(built_key.nodes)
        nodes: list[SchemaNodePayload] = built_key.nodes + rebase_nodes(
            built_value.nodes,
            value_offset,
        )
        mapping: SchemaNodePayload = SchemaNodePayload(
            "dict",
            [built_key.root, built_value.root + value_offset],
            None,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            inherited,
            [],
        )
        root: int = len(nodes)
        return NodeBuildResult(nodes + [mapping], root, None)
    if node.kind == "tuple" or node.kind == "union":
        member_nodes: list[SchemaNodePayload] = []
        member_roots: list[int] = []
        for member in node.members:
            built_member: NodeBuildResult = build_node(member, [])
            if built_member.issue is not None:
                return built_member
            offset: int = len(member_nodes)
            member_nodes = member_nodes + rebase_nodes(built_member.nodes, offset)
            member_roots.append(built_member.root + offset)
        sequence: SchemaNodePayload = SchemaNodePayload(
            sum_kind(node.kind, inherited),
            member_roots,
            None,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            inherited,
            [],
        )
        root: int = len(member_nodes)
        return NodeBuildResult(member_nodes + [sequence], root, None)
    if node.kind == "nominal":
        override = error_override(inherited + node.metadata)
        if override.issue is not None:
            return NodeBuildResult([], 0, override.issue)
        model_rules_value: ModelRules = model_rules(node.metadata)
        if model_rules_value.issue is not None:
            return NodeBuildResult([], 0, model_rules_value.issue)
        field_nodes: list[SchemaNodePayload] = []
        field_roots: list[int] = []
        model_fields: list[SchemaFieldPayload] = []
        for field in node.fields:
            built_field: NodeBuildResult = build_node(field.type, field.metadata)
            if built_field.issue is not None:
                return built_field
            offset: int = len(field_nodes)
            field_nodes = field_nodes + rebase_nodes(built_field.nodes, offset)
            field_root: int = built_field.root + offset
            field_roots.append(field_root)
            field_rules_value: FieldRules = field_rules(field.metadata)
            if field_rules_value.issue is not None:
                return NodeBuildResult([], 0, field_rules_value.issue)
            model_fields.append(
                SchemaFieldPayload(
                    field.name,
                    field_root,
                    field.required,
                    field.default,
                    field_rules_value.validation_alias,
                )
            )
        model_payload: SchemaModelPayload = SchemaModelPayload(
            node.identity,
            node.identity,
            model_fields,
            model_rules_value.extra,
            model_rules_value.populate_by_name,
            model_rules_value.location_by_alias,
        )
        model_definition: str | None = node.identity
        model_value: SchemaModelPayload | None = model_payload
        model: SchemaNodePayload = SchemaNodePayload(
            "model",
            field_roots,
            model_definition,
            None,
            override.code,
            override.message,
            model_value,
            None,
            None,
            None,
            inherited + node.metadata,
            [],
        )
        root: int = len(field_nodes)
        return NodeBuildResult(field_nodes + [model], root, None)
    if node.kind == "enum":
        override = error_override(inherited + node.metadata)
        if override.issue is not None:
            return NodeBuildResult([], 0, override.issue)
        enum_definition: str | None = node.identity
        enumeration: SchemaNodePayload = SchemaNodePayload(
            "enum",
            [],
            enum_definition,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            inherited + node.metadata,
            node.variants,
        )
        return NodeBuildResult([enumeration], 0, None)
    if node.kind == "newtype":
        override = error_override(inherited + node.metadata)
        if override.issue is not None:
            return NodeBuildResult([], 0, override.issue)
        inner: ShapeNode | None = node.inner
        if inner is None:
            return NodeBuildResult([], 0, "newtype schema node has no inner type")
        built_inner: NodeBuildResult = build_node(inner, [])
        if built_inner.issue is not None:
            return built_inner
        wrapper_definition: str | None = node.identity
        wrapper: SchemaNodePayload = SchemaNodePayload(
            "model",
            [built_inner.root],
            wrapper_definition,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            inherited + node.metadata,
            [],
        )
        root: int = len(built_inner.nodes)
        return NodeBuildResult(built_inner.nodes + [wrapper], root, None)
    return NodeBuildResult([], 0, "structural shape cannot form a schema program")


@const_eval
def expected_arity(kind: str) -> int:
    if kind == "list" or kind == "set" or kind == "nullable":
        return 1
    if kind == "dict":
        return 2
    if kind == "lax-or-strict" or kind == "json-or-structural":
        return 2
    if (
        kind == "model"
        or kind == "tuple"
        or kind == "union"
        or kind == "literal"
        or kind == "tagged-union"
        or kind == "chain"
    ):
        return -1
    return 0


@const_eval
def verify_nodes(nodes: list[SchemaNodePayload], root: int) -> str | None:
    count: int = len(nodes)
    if count == 0:
        return "schema program has no nodes"
    if count > 4096:
        return "schema program exceeds the static node limit"
    if root < 0 or root >= count:
        return "schema root is out of range"
    for node in nodes:
        arity: int = expected_arity(node.kind)
        if arity >= 0 and len(node.children) != arity:
            return "schema node has invalid child arity"
        if node.kind == "chain" and len(node.children) == 0:
            return "typed chain has no steps"
        for child in node.children:
            if child < 0 or child >= count:
                return "schema child index is out of range"
        if node.reference is not None and node.kind != "definition-ref":
            return "non-reference schema node has a reference"
        if node.kind == "definition-ref" and node.reference is None:
            return "definition reference has no identity"
        if node.error_code is None and node.error_message is not None:
            return "schema node has an error message without a code"
        if node.error_code is not None and node.error_message is None:
            return "schema node has an error code without a message"
    for left in nodes:
        if left.definition is not None:
            matches: int = 0
            for right in nodes:
                if right.definition == left.definition:
                    matches += 1
            if matches != 1:
                return "schema program has duplicate definition identities"
    for reference in nodes:
        if reference.reference is not None:
            found: bool = False
            for target in nodes:
                if target.definition == reference.reference:
                    found = True
            if not found:
                return "schema program has a dangling definition reference"
    return None


@const_eval
@metadata("sifr.meta.issue_template", ("schema_invalid", ["problem"]))
def verify_schema(shape: ShapeInput) -> SchemaOutcome:
    built: NodeBuildResult = build_node(shape.root, [])
    build_issue: str | None = built.issue
    if build_issue is not None:
        return schema_failure(build_issue)
    problem: str | None = verify_nodes(built.nodes, built.root)
    if problem is not None:
        return schema_failure(problem)
    program: SchemaProgramPayload = SchemaProgramPayload(
        1,
        1,
        1,
        1,
        15,
        shape.canonical_identity,
        built.root,
        built.nodes,
    )
    return SchemaOutcome("produced", program, [])
