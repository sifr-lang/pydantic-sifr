from .errors import SchemaIssue, SchemaIssueArgs
from .descriptors import PydanticDescriptor
from sifr.meta import CallableIdentity, SourceOrigin
from .schema_errors import error_override
from .schema_metadata import runtime_metadata
from .schema_constraints import constraint_issue, copy_metadata
from .schema_constraints import descriptor_values
from .schema_constraints import has_integer_constraints, has_string_constraints
from .schema_constraints import has_text_constraints
from .schema_constraints import primitive_kind, sum_kind
from .schema_types import ErrorOverrideResult
from .schema_types import FieldRules
from .schema_types import ModelRules
from .schema_types import NodeBuildResult
from .schema_types import SchemaAliasPathPayload
from .schema_types import SchemaFieldPayload
from .schema_types import SchemaModelPayload
from .schema_types import SchemaNodePayload
from .schema_types import SchemaOutcome
from .schema_types import SchemaProgramPayload
from .schema_types import SchemaValidatorPayload
from .schema_types import SchemaShapeField, SchemaShapeInput, SchemaShapeMetadata
from .schema_types import SchemaShapeMethod, SchemaShapeNode, SchemaShapeParameter
from .schema_rules import alias_path, alias_paths, empty_field_rules
from .schema_rules import field_rules, float_constraints, model_rules
from .schema_rules import runtime_variants
from .schema_nodes import expected_arity, namespace_validator_nodes, rebase_nodes
from .schema_nodes import verify_nodes


@const_eval
def schema_failure(problem: str, own origin: SourceOrigin) -> SchemaOutcome:
    issue: SchemaIssue = SchemaIssue(
        "pydantic_sifr.schema_contract",
        "schema_invalid",
        "fatal",
        SchemaIssueArgs(problem),
        origin,
        [],
        [],
    )
    return SchemaOutcome("failed", None, [issue])


@const_eval
def validator_targets(descriptor: PydanticDescriptor) -> list[str]:
    output: list[str] = []
    targets: list[str] | None = descriptor.validator_fields
    if targets is not None:
        selected: list[str] = targets
        for target in selected:
            output.append(target)
    return output


@const_eval
def targets_field(descriptor: PydanticDescriptor, field: str) -> bool:
    for target in validator_targets(descriptor):
        if target == field:
            return True
    return False


@const_eval
def field_exists(node: SchemaShapeNode, target: str) -> bool:
    for field in node.fields:
        if field.name == target:
            return True
    return False


@const_eval
def same_shape_head(left: SchemaShapeNode, right: SchemaShapeNode) -> bool:
    if left.kind != right.kind:
        return False
    if left.kind == "primitive" or left.kind == "fixed_integer":
        return left.name == right.name
    if (
        left.kind == "nominal"
        or left.kind == "enum"
        or left.kind == "newtype"
        or left.kind == "recursive_reference"
    ):
        return left.identity == right.identity
    return True


@const_eval
def is_model_output(output: SchemaShapeNode, model: SchemaShapeNode) -> bool:
    if same_shape_head(output, model):
        return True
    return output.kind == "recursive_reference" and output.identity == model.identity


@const_eval
def nested_validator_problem(node: SchemaShapeNode, is_root: bool) -> str | None:
    if node.kind == "nominal":
        if not is_root:
            for method in node.methods:
                descriptor: PydanticDescriptor | None = method.descriptor
                if descriptor is not None:
                    selected: PydanticDescriptor = descriptor
                    if (
                        selected.kind == "field-validator"
                        or selected.kind == "model-validator"
                    ):
                        return "nested models with validators require their own validation boundary"
        for field in node.fields:
            problem: str | None = nested_validator_problem(field.type, False)
            if problem is not None:
                return problem
    elif node.kind == "list" or node.kind == "set" or node.kind == "optional":
        element: SchemaShapeNode | None = node.element
        if element is not None:
            problem: str | None = nested_validator_problem(element, False)
            if problem is not None:
                return problem
    elif node.kind == "dictionary":
        key: SchemaShapeNode | None = node.key
        if key is not None:
            problem: str | None = nested_validator_problem(key, False)
            if problem is not None:
                return problem
        value: SchemaShapeNode | None = node.value
        if value is not None:
            problem: str | None = nested_validator_problem(value, False)
            if problem is not None:
                return problem
    elif node.kind == "tuple" or node.kind == "union":
        for member in node.members:
            problem: str | None = nested_validator_problem(member, False)
            if problem is not None:
                return problem
    elif node.kind == "newtype":
        inner: SchemaShapeNode | None = node.inner
        if inner is not None:
            problem: str | None = nested_validator_problem(inner, False)
            if problem is not None:
                return problem
    return None


@const_eval
def validator_problem(node: SchemaShapeNode, method: SchemaShapeMethod) -> str | None:
    descriptor: PydanticDescriptor | None = method.descriptor
    if descriptor is None:
        return None
    selected: PydanticDescriptor = descriptor
    if method.is_async:
        return "validator methods cannot be async"
    if selected.kind == "field-validator":
        targets: list[str] = validator_targets(selected)
        for target in targets:
            if not field_exists(node, target):
                return "field validator target does not name a declared field"
        if method.receiver is not None:
            return "field validator cannot declare an instance receiver"
        if method.kind != "class" and method.kind != "static":
            return "field validator must be a class or static method"
        if len(method.params) == 0:
            return "field validator has no value input"
        if len(method.params) > 2:
            return "field validator has too many inputs"
        parameter: SchemaShapeParameter | None = method.params[0]
        if parameter is not None:
            selected_parameter: SchemaShapeParameter = parameter
            if selected_parameter.convention != "own":
                return "field validator value input must be owned"
        for target in targets:
            for field in node.fields:
                if field.name == target and not same_shape_head(
                    method.output, field.type
                ):
                    return "field validator output does not match its field type"
        mode: str | None = selected.validator_mode
        if mode == "after":
            after_parameter: SchemaShapeParameter | None = method.params[0]
            if after_parameter is not None:
                selected_parameter: SchemaShapeParameter = after_parameter
                for target in targets:
                    for field in node.fields:
                        if field.name == target and not same_shape_head(
                            selected_parameter.type, field.type
                        ):
                            return "field after validator input does not match its field type"
    elif selected.kind == "model-validator":
        mode: str | None = selected.validator_mode
        if mode == "before":
            if method.receiver is not None:
                return "model before validator cannot declare an instance receiver"
            if method.kind != "class" and method.kind != "static":
                return "model before validator must be a class or static method"
            if len(method.params) == 0:
                return "model before validator has no structural input"
            if len(method.params) > 2:
                return "model before validator has too many inputs"
            parameter: SchemaShapeParameter | None = method.params[0]
            if parameter is not None:
                selected_parameter: SchemaShapeParameter = parameter
                if selected_parameter.convention != "own":
                    return "model before validator input must be owned"
                if selected_parameter.type.kind != "nominal":
                    return "model before validator input must be a concrete structural type"
            if method.output.kind != "nominal":
                return (
                    "model before validator output must be a concrete structural type"
                )
        elif mode == "after":
            if method.kind != "regular" or method.receiver != "own":
                return "model after validator must consume its model receiver"
            if len(method.params) > 1:
                return "model after validator has too many inputs"
            if not is_model_output(method.output, node):
                return "model after validator output must be its model type"
    return None


@const_eval
def validator_node(
    kind: str,
    children: list[int],
    slot: int,
    target: str,
) -> SchemaNodePayload:
    return SchemaNodePayload(
        kind,
        children,
        None,
        None,
        None,
        None,
        None,
        None,
        None,
        None,
        None,
        None,
        None,
        [],
        [],
        slot,
        target,
    )


@const_eval
def wrap_before_validator(
    own current: NodeBuildResult,
    input_type: SchemaShapeNode,
    slot: int,
    target: str,
    kind: str,
) -> NodeBuildResult:
    built_input: NodeBuildResult = build_node(input_type, [])
    if built_input.issue is not None:
        return built_input
    current_offset: int = len(built_input.nodes)
    nodes: list[SchemaNodePayload] = built_input.nodes + rebase_nodes(
        current.nodes, current_offset
    )
    wrapper: SchemaNodePayload = validator_node(
        kind,
        [built_input.root, current.root + current_offset],
        slot,
        target,
    )
    root: int = len(nodes)
    return NodeBuildResult(nodes + [wrapper], root, None)


@const_eval
def wrap_after_validator(
    own current: NodeBuildResult,
    output_type: SchemaShapeNode,
    slot: int,
    target: str,
) -> NodeBuildResult:
    built_output: NodeBuildResult = build_node_mode(output_type, [], False)
    if built_output.issue is not None:
        return built_output
    namespaced_output: list[SchemaNodePayload] = namespace_validator_nodes(
        built_output.nodes, slot, target
    )
    output_offset: int = len(current.nodes)
    nodes: list[SchemaNodePayload] = current.nodes + rebase_nodes(
        namespaced_output, output_offset
    )
    wrapper: SchemaNodePayload = validator_node(
        "function-after",
        [current.root, built_output.root + output_offset],
        slot,
        target,
    )
    root: int = len(nodes)
    return NodeBuildResult(nodes + [wrapper], root, None)


@const_eval
def field_validator_pipeline(
    node: SchemaShapeNode,
    field: SchemaShapeField,
    own normal: NodeBuildResult,
) -> NodeBuildResult:
    current: NodeBuildResult = normal
    slot: int = 0
    for method in node.methods:
        descriptor: PydanticDescriptor | None = method.descriptor
        target: CallableIdentity | None = method.target
        if descriptor is not None and target is not None:
            selected: PydanticDescriptor = descriptor
            if selected.kind == "field-validator" or selected.kind == "model-validator":
                if (
                    selected.kind == "field-validator"
                    and selected.validator_mode == "plain"
                    and targets_field(selected, field.name)
                ):
                    output: NodeBuildResult = build_node_mode(field.type, [], False)
                    if output.issue is not None:
                        return output
                    parameter: SchemaShapeParameter | None = method.params[0]
                    if parameter is not None:
                        selected_parameter: SchemaShapeParameter = parameter
                        current = wrap_before_validator(
                            output,
                            selected_parameter.type,
                            slot,
                            "field:" + field.name,
                            "function-plain",
                        )
                slot += 1
    slot = 0
    for method in node.methods:
        descriptor: PydanticDescriptor | None = method.descriptor
        target: CallableIdentity | None = method.target
        if descriptor is not None and target is not None:
            selected: PydanticDescriptor = descriptor
            if selected.kind == "field-validator" or selected.kind == "model-validator":
                if (
                    selected.kind == "field-validator"
                    and selected.validator_mode == "before"
                    and targets_field(selected, field.name)
                ):
                    parameter: SchemaShapeParameter | None = method.params[0]
                    if parameter is not None:
                        selected_parameter: SchemaShapeParameter = parameter
                        current = wrap_before_validator(
                            current,
                            selected_parameter.type,
                            slot,
                            "field:" + field.name,
                            "function-before",
                        )
                    if current.issue is not None:
                        return current
                slot += 1
    slot = 0
    for method in node.methods:
        descriptor: PydanticDescriptor | None = method.descriptor
        target: CallableIdentity | None = method.target
        if descriptor is not None and target is not None:
            selected: PydanticDescriptor = descriptor
            if selected.kind == "field-validator" or selected.kind == "model-validator":
                if (
                    selected.kind == "field-validator"
                    and selected.validator_mode == "after"
                    and targets_field(selected, field.name)
                ):
                    current = wrap_after_validator(
                        current,
                        field.type,
                        slot,
                        "field:" + field.name,
                    )
                    if current.issue is not None:
                        return current
                slot += 1
    return current


@const_eval
def model_validator_pipeline(
    node: SchemaShapeNode, own normal: NodeBuildResult
) -> NodeBuildResult:
    current: NodeBuildResult = normal
    slot: int = 0
    for method in node.methods:
        descriptor: PydanticDescriptor | None = method.descriptor
        target: CallableIdentity | None = method.target
        if descriptor is not None and target is not None:
            selected: PydanticDescriptor = descriptor
            if selected.kind == "field-validator" or selected.kind == "model-validator":
                if (
                    selected.kind == "model-validator"
                    and selected.validator_mode == "before"
                ):
                    parameter: SchemaShapeParameter | None = method.params[0]
                    if parameter is not None:
                        selected_parameter: SchemaShapeParameter = parameter
                        current = wrap_before_validator(
                            current,
                            selected_parameter.type,
                            slot,
                            "model",
                            "function-before",
                        )
                    if current.issue is not None:
                        return current
                slot += 1
    slot = 0
    for method in node.methods:
        descriptor: PydanticDescriptor | None = method.descriptor
        target: CallableIdentity | None = method.target
        if descriptor is not None and target is not None:
            selected: PydanticDescriptor = descriptor
            if selected.kind == "field-validator" or selected.kind == "model-validator":
                if (
                    selected.kind == "model-validator"
                    and selected.validator_mode == "after"
                ):
                    current = wrap_after_validator(current, node, slot, "model")
                    if current.issue is not None:
                        return current
                slot += 1
    return current


@const_eval
def build_node(
    node: SchemaShapeNode, inherited: list[SchemaShapeMetadata]
) -> NodeBuildResult:
    return build_node_mode(node, inherited, True)


@const_eval
def build_node_mode(
    node: SchemaShapeNode,
    inherited: list[SchemaShapeMetadata],
    apply_validators: bool,
) -> NodeBuildResult:
    override: ErrorOverrideResult = error_override(inherited)
    if override.issue is not None:
        return NodeBuildResult([], 0, override.issue)
    rules: FieldRules = field_rules(inherited)
    if rules.issue is not None:
        return NodeBuildResult([], 0, rules.issue)
    if node.kind == "primitive" or node.kind == "fixed_integer":
        kind: str = "int"
        if node.kind == "primitive":
            kind = primitive_kind(node.name)
        if kind == "":
            return NodeBuildResult([], 0, "unsupported structural primitive")
        if sum_kind(kind, inherited) == "literal" and (
            has_integer_constraints(copy_metadata(inherited))
            or has_string_constraints(copy_metadata(inherited))
        ):
            return NodeBuildResult(
                [], 0, "field constraints are not supported for literal fields"
            )
        invalid_constraints: str | None = constraint_issue(
            kind, copy_metadata(inherited)
        )
        if invalid_constraints is not None:
            return NodeBuildResult([], 0, invalid_constraints)
        integer_target: str | None = None
        if kind == "int":
            if node.kind == "fixed_integer":
                integer_target = node.name
            else:
                integer_target = "int"
        leaf: SchemaNodePayload = SchemaNodePayload(
            sum_kind(kind, inherited),
            [],
            None,
            None,
            override.code,
            override.message,
            None,
            integer_target,
            rules.integer_constraints,
            float_constraints(inherited),
            rules.string_constraints,
            rules.bytes_constraints,
            rules.collection_constraints,
            runtime_metadata(inherited),
            [],
        )
        return NodeBuildResult([leaf], 0, None)
    if node.kind == "recursive_reference":
        if has_integer_constraints(copy_metadata(inherited)) or has_string_constraints(
            copy_metadata(inherited)
        ):
            return NodeBuildResult(
                [], 0, "field constraints are not supported for recursive references"
            )
        reference: SchemaNodePayload = SchemaNodePayload(
            "definition-ref",
            [],
            None,
            node.identity,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            runtime_metadata(inherited),
            [],
        )
        return NodeBuildResult([reference], 0, None)
    if node.kind == "list" or node.kind == "set" or node.kind == "optional":
        element: SchemaShapeNode | None = node.element
        if element is None:
            return NodeBuildResult([], 0, "unary schema node has no element")
        child_metadata: list[SchemaShapeMetadata] = []
        if node.kind == "optional":
            child_metadata = copy_metadata(inherited)
        else:
            collection_issue: str | None = constraint_issue(
                node.kind, copy_metadata(inherited)
            )
            if collection_issue is not None:
                return NodeBuildResult([], 0, collection_issue)
        built_element: NodeBuildResult = build_node_mode(
            element, child_metadata, apply_validators
        )
        if built_element.issue is not None:
            return built_element
        unary_kind: str = "list"
        if node.kind == "set":
            unary_kind = "set"
        if node.kind == "optional":
            unary_kind = "nullable"
        unary: SchemaNodePayload = SchemaNodePayload(
            sum_kind(unary_kind, inherited),
            [built_element.root],
            None,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            None,
            None,
            rules.collection_constraints,
            runtime_metadata(inherited),
            [],
        )
        root: int = len(built_element.nodes)
        return NodeBuildResult(built_element.nodes + [unary], root, None)
    if node.kind == "dictionary":
        mapping_issue: str | None = constraint_issue(
            "dictionary", copy_metadata(inherited)
        )
        if mapping_issue is not None:
            return NodeBuildResult([], 0, mapping_issue)
        key: SchemaShapeNode | None = node.key
        value: SchemaShapeNode | None = node.value
        if key is None or value is None:
            return NodeBuildResult([], 0, "mapping schema node is incomplete")
        built_key: NodeBuildResult = build_node_mode(key, [], apply_validators)
        if built_key.issue is not None:
            return built_key
        built_value: NodeBuildResult = build_node_mode(value, [], apply_validators)
        if built_value.issue is not None:
            return built_value
        value_offset: int = len(built_key.nodes)
        nodes: list[SchemaNodePayload] = built_key.nodes + rebase_nodes(
            built_value.nodes,
            value_offset,
        )
        mapping: SchemaNodePayload = SchemaNodePayload(
            "dict",
            [built_key.root, built_value.root + value_offset],
            None,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            None,
            None,
            rules.collection_constraints,
            runtime_metadata(inherited),
            [],
        )
        root: int = len(nodes)
        return NodeBuildResult(nodes + [mapping], root, None)
    if node.kind == "tuple" or node.kind == "union":
        sequence_issue: str | None = None
        if node.kind == "union" and (
            has_integer_constraints(copy_metadata(inherited))
            or has_string_constraints(copy_metadata(inherited))
        ):
            sequence_issue = "field constraints are not supported for unions"
        if node.kind == "tuple":
            sequence_issue = constraint_issue("tuple", copy_metadata(inherited))
        if sequence_issue is not None:
            return NodeBuildResult([], 0, sequence_issue)
        member_nodes: list[SchemaNodePayload] = []
        member_roots: list[int] = []
        for member in node.members:
            built_member: NodeBuildResult = build_node_mode(
                member, [], apply_validators
            )
            if built_member.issue is not None:
                return built_member
            offset: int = len(member_nodes)
            member_nodes = member_nodes + rebase_nodes(built_member.nodes, offset)
            member_roots.append(built_member.root + offset)
        sequence: SchemaNodePayload = SchemaNodePayload(
            sum_kind(node.kind, inherited),
            member_roots,
            None,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            None,
            None,
            rules.collection_constraints,
            runtime_metadata(inherited),
            [],
        )
        root: int = len(member_nodes)
        return NodeBuildResult(member_nodes + [sequence], root, None)
    if node.kind == "nominal":
        special_kind: str = ""
        if node.identity == "pydantic_sifr.special_values.Url":
            special_kind = "url"
        elif node.identity == "pydantic_sifr.special_values.MultiHostUrl":
            special_kind = "multi-host-url"
        elif node.identity == "pydantic_sifr.special_values.Pattern":
            special_kind = "pattern"
        if special_kind != "":
            if has_integer_constraints(
                copy_metadata(inherited)
            ) or has_string_constraints(copy_metadata(inherited)):
                return NodeBuildResult(
                    [], 0, "field constraints are not supported for specialized values"
                )
            specialized: SchemaNodePayload = SchemaNodePayload(
                special_kind,
                [],
                None,
                None,
                override.code,
                override.message,
                None,
                None,
                None,
                None,
                None,
                None,
                None,
                runtime_metadata(inherited),
                [],
            )
            return NodeBuildResult([specialized], 0, None)
        if has_integer_constraints(copy_metadata(inherited)) or has_string_constraints(
            copy_metadata(inherited)
        ):
            return NodeBuildResult(
                [], 0, "field constraints are not supported for model fields"
            )
        override = error_override(inherited + node.metadata)
        if override.issue is not None:
            return NodeBuildResult([], 0, override.issue)
        model_rules_value: ModelRules = model_rules(node.metadata)
        if model_rules_value.issue is not None:
            return NodeBuildResult([], 0, model_rules_value.issue)
        field_nodes: list[SchemaNodePayload] = []
        field_roots: list[int] = []
        model_fields: list[SchemaFieldPayload] = []
        for field in node.fields:
            repeated_definition: bool = False
            if field.type.kind == "nominal":
                for existing in field_nodes:
                    if existing.definition == field.type.identity + "":
                        repeated_definition = True
            built_field: NodeBuildResult = NodeBuildResult([], 0, None)
            if repeated_definition:
                field_override: ErrorOverrideResult = error_override(field.metadata)
                if field_override.issue is not None:
                    return NodeBuildResult([], 0, field_override.issue)
                reference_node: SchemaNodePayload = SchemaNodePayload(
                    "definition-ref",
                    [],
                    None,
                    field.type.identity + "",
                    field_override.code,
                    field_override.message,
                    None,
                    None,
                    None,
                    None,
                    None,
                    None,
                    None,
                    runtime_metadata(field.metadata),
                    [],
                )
                built_field = NodeBuildResult([reference_node], 0, None)
            else:
                built_field = build_node_mode(
                    field.type, field.metadata, apply_validators
                )
            if built_field.issue is not None:
                return built_field
            if apply_validators:
                built_field = field_validator_pipeline(node, field, built_field)
                if built_field.issue is not None:
                    return built_field
            offset: int = len(field_nodes)
            field_nodes = field_nodes + rebase_nodes(built_field.nodes, offset)
            field_root: int = built_field.root + offset
            field_roots.append(field_root)
            field_rules_value: FieldRules = field_rules(field.metadata)
            if field_rules_value.issue is not None:
                return NodeBuildResult([], 0, field_rules_value.issue)
            validation_aliases: list[SchemaAliasPathPayload] = (
                field_rules_value.validation_aliases
            )
            serialization_alias: str | None = field_rules_value.serialization_alias
            if len(validation_aliases) == 0 and len(model_rules_value.alias_prefix) > 0:
                generated_alias: str = model_rules_value.alias_prefix + field.name
                generated_path: list[str | int] = []
                generated_path.append(generated_alias)
                validation_aliases.append(alias_path(generated_path))
                if serialization_alias is None:
                    serialization_alias = model_rules_value.alias_prefix + field.name
            if not model_rules_value.validate_by_alias:
                validation_aliases = []
            model_fields.append(
                SchemaFieldPayload(
                    field.name,
                    field_root,
                    field.required,
                    field.default_kind,
                    field.default,
                    validation_aliases,
                    serialization_alias,
                    field_rules_value.strict,
                    field_rules_value.exclude,
                )
            )
        model_payload: SchemaModelPayload = SchemaModelPayload(
            node.identity,
            node.identity,
            model_fields,
            model_rules_value.extra,
            model_rules_value.populate_by_name,
            model_rules_value.location_by_alias,
            model_rules_value.strict,
        )
        model_definition: str | None = node.identity
        model_value: SchemaModelPayload | None = model_payload
        model: SchemaNodePayload = SchemaNodePayload(
            "model",
            field_roots,
            model_definition,
            None,
            override.code,
            override.message,
            model_value,
            None,
            None,
            None,
            None,
            None,
            None,
            runtime_metadata(inherited + node.metadata),
            [],
        )
        root: int = len(field_nodes)
        normal_model: NodeBuildResult = NodeBuildResult(
            field_nodes + [model], root, None
        )
        if not apply_validators:
            return normal_model
        return model_validator_pipeline(node, normal_model)
    if node.kind == "enum":
        if has_integer_constraints(copy_metadata(inherited)) or has_string_constraints(
            copy_metadata(inherited)
        ):
            return NodeBuildResult(
                [], 0, "field constraints are not supported for enum fields"
            )
        override = error_override(inherited + node.metadata)
        if override.issue is not None:
            return NodeBuildResult([], 0, override.issue)
        enum_definition: str | None = node.identity
        enumeration: SchemaNodePayload = SchemaNodePayload(
            "enum",
            [],
            enum_definition,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            runtime_metadata(inherited + node.metadata),
            runtime_variants(node),
        )
        return NodeBuildResult([enumeration], 0, None)
    if node.kind == "newtype":
        return NodeBuildResult([], 0, "newtype schemas are not supported")
    return NodeBuildResult([], 0, "structural shape cannot form a schema program")


@const_eval
@metadata("sifr.meta.issue_template", ("schema_invalid", ["problem"]))
def verify_schema(shape: SchemaShapeInput) -> SchemaOutcome:
    nested_problem: str | None = nested_validator_problem(shape.root, True)
    if nested_problem is not None:
        return schema_failure(nested_problem, shape.declaration.origin)
    for method in shape.root.methods:
        problem: str | None = validator_problem(shape.root, method)
        if problem is not None:
            origin: SourceOrigin | None = method.origin
            if origin is not None:
                return schema_failure(problem, origin)
            return schema_failure(problem, shape.declaration.origin)
    built: NodeBuildResult = build_node(shape.root, [])
    build_issue: str | None = built.issue
    if build_issue is not None:
        return schema_failure(build_issue, shape.declaration.origin)
    problem: str | None = verify_nodes(built.nodes, built.root)
    if problem is not None:
        return schema_failure(problem, shape.declaration.origin)
    slots: list[CallableIdentity] = []
    validators: list[SchemaValidatorPayload] = []
    for method in shape.root.methods:
        target: CallableIdentity | None = method.target
        descriptor: PydanticDescriptor | None = method.descriptor
        if target is not None and descriptor is not None:
            selected: PydanticDescriptor = descriptor
            if selected.kind == "field-validator" or selected.kind == "model-validator":
                slots.append(target)
                mode: str | None = selected.validator_mode
                if mode is not None:
                    validators.append(
                        SchemaValidatorPayload(
                            len(slots) - 1,
                            selected.kind,
                            mode,
                            validator_targets(selected),
                        )
                    )
    program: SchemaProgramPayload = SchemaProgramPayload(
        1,
        1,
        1,
        1,
        15,
        shape.canonical_identity,
        built.root,
        built.nodes,
        slots,
        validators,
    )
    return SchemaOutcome("produced", program, [])
