from .errors import SchemaIssue, SchemaIssueArgs
from .descriptors import AliasSelection, PydanticDescriptor
from sifr.meta import SourceOrigin
from .schema_errors import error_override
from .schema_metadata import runtime_metadata
from .schema_constraints import constraint_issue, copy_metadata
from .schema_constraints import (
    descriptor_values,
    has_integer_constraints,
    has_string_constraints,
    has_text_constraints,
)
from .schema_constraints import primitive_kind, sum_kind
from .schema_types import ErrorOverrideResult
from .schema_types import FieldRules
from .schema_types import ModelRules
from .schema_types import NodeBuildResult
from .schema_types import SchemaAliasSegmentPayload
from .schema_types import SchemaAliasPathPayload
from .schema_types import SchemaBytesConstraintsPayload
from .schema_types import SchemaCollectionConstraintsPayload
from .schema_types import SchemaFieldPayload
from .schema_types import SchemaFloatConstraintsPayload
from .schema_types import SchemaIntegerConstraintsPayload
from .schema_types import SchemaModelPayload
from .schema_types import SchemaNodePayload
from .schema_types import SchemaOutcome
from .schema_types import SchemaProgramPayload
from .schema_types import SchemaStringConstraintsPayload
from .schema_types import SchemaVariantPayload
from .schema_types import SchemaShapeInput, SchemaShapeMetadata, SchemaShapeNode


@const_eval
def schema_failure(problem: str, own origin: SourceOrigin) -> SchemaOutcome:
    issue: SchemaIssue = SchemaIssue(
        "pydantic_sifr.schema_contract",
        "schema_invalid",
        "fatal",
        SchemaIssueArgs(problem),
        origin,
        [],
        [],
    )
    return SchemaOutcome("failed", None, [issue])


@const_eval
def alias_path(value: list[str | int]) -> SchemaAliasPathPayload:
    segments: list[SchemaAliasSegmentPayload] = []
    for segment in value:
        if isinstance(segment, str):
            segments.append(SchemaAliasSegmentPayload("field", segment, None))
        else:
            index: int = segment
            segments.append(SchemaAliasSegmentPayload("index", None, index))
    return SchemaAliasPathPayload(segments)


@const_eval
def alias_paths(
    value: AliasSelection | None,
) -> list[SchemaAliasPathPayload]:
    output: list[SchemaAliasPathPayload] = []
    if value is not None:
        for path in value.paths:
            output.append(alias_path(path))
    return output


@const_eval
def runtime_variants(node: SchemaShapeNode) -> list[SchemaVariantPayload]:
    output: list[SchemaVariantPayload] = []
    for variant in node.variants:
        output.append(SchemaVariantPayload(variant.name, variant.value, []))
    return output


@const_eval
def field_rules(metadata: list[SchemaShapeMetadata]) -> FieldRules:
    validation_aliases: list[SchemaAliasPathPayload] = []
    serialization_alias: str | None = None
    greater_than: int | float | None = None
    greater_or_equal: int | float | None = None
    less_than: int | float | None = None
    less_or_equal: int | float | None = None
    multiple_of: int | float | None = None
    min_length: int | None = None
    max_length: int | None = None
    pattern: str | None = None
    strip_whitespace: bool = False
    to_lower: bool = False
    to_upper: bool = False
    ascii_only: bool = False
    strict: bool | None = None
    exclude: bool = False
    for value in descriptor_values(metadata):
        if value.kind == "field":
            selected_aliases: list[SchemaAliasPathPayload] = alias_paths(
                value.validation_alias
            )
            direct_alias: str | None = value.alias
            if len(selected_aliases) == 0:
                if direct_alias is not None:
                    direct_path: list[str | int] = []
                    direct_path.append(direct_alias)
                    selected_aliases.append(alias_path(direct_path))
            if len(selected_aliases) > 0:
                validation_aliases = selected_aliases
            selected_serialization_alias: str | None = value.serialization_alias
            if selected_serialization_alias is None:
                selected_serialization_alias = value.alias
            if selected_serialization_alias is not None:
                serialization_alias = selected_serialization_alias
            if value.gt is not None:
                greater_than = value.gt
            if value.ge is not None:
                greater_or_equal = value.ge
            if value.lt is not None:
                less_than = value.lt
            if value.le is not None:
                less_or_equal = value.le
            if value.multiple_of is not None:
                multiple_of = value.multiple_of
            if value.min_length is not None:
                min_length = value.min_length
            if value.max_length is not None:
                max_length = value.max_length
            if value.pattern is not None:
                pattern = value.pattern
            strip_value: bool | None = value.strip_whitespace
            if strip_value is not None:
                strip_whitespace = strip_value
            lower_value: bool | None = value.to_lower
            if lower_value is not None:
                to_lower = lower_value
            upper_value: bool | None = value.to_upper
            if upper_value is not None:
                to_upper = upper_value
            ascii_value: bool | None = value.ascii_only
            if ascii_value is not None:
                ascii_only = ascii_value
            strict_value: bool | None = value.strict
            if strict_value is not None:
                strict = strict_value
            exclude_value: bool | None = value.exclude
            if exclude_value is not None:
                exclude = exclude_value
    if min_length is not None and max_length is not None:
        minimum: int = min_length
        maximum: int = max_length
        if minimum > maximum:
            return FieldRules(
                [],
                None,
                SchemaIntegerConstraintsPayload(None, None, None, None, None),
                SchemaStringConstraintsPayload(
                    None, None, False, False, False, False, None
                ),
                SchemaBytesConstraintsPayload(None, None),
                SchemaCollectionConstraintsPayload(None, None),
                None,
                False,
                "min_length cannot exceed max_length after descriptor merge",
            )
    if to_lower and to_upper:
        return FieldRules(
            [],
            None,
            SchemaIntegerConstraintsPayload(None, None, None, None, None),
            SchemaStringConstraintsPayload(
                None, None, False, False, False, False, None
            ),
            SchemaBytesConstraintsPayload(None, None),
            SchemaCollectionConstraintsPayload(None, None),
            None,
            False,
            "to_lower and to_upper cannot both be enabled",
        )
    return FieldRules(
        validation_aliases,
        serialization_alias,
        SchemaIntegerConstraintsPayload(
            greater_than, greater_or_equal, less_than, less_or_equal, multiple_of
        ),
        SchemaStringConstraintsPayload(
            min_length,
            max_length,
            strip_whitespace,
            to_lower,
            to_upper,
            ascii_only,
            pattern,
        ),
        SchemaBytesConstraintsPayload(min_length, max_length),
        SchemaCollectionConstraintsPayload(min_length, max_length),
        strict,
        exclude,
        None,
    )


@const_eval
def float_constraints(
    metadata: list[SchemaShapeMetadata],
) -> SchemaFloatConstraintsPayload:
    greater_than: int | float | None = None
    greater_or_equal: int | float | None = None
    less_than: int | float | None = None
    less_or_equal: int | float | None = None
    multiple_of: int | float | None = None
    for value in descriptor_values(metadata):
        if value.kind == "field":
            if value.gt is not None:
                greater_than = value.gt
            if value.ge is not None:
                greater_or_equal = value.ge
            if value.lt is not None:
                less_than = value.lt
            if value.le is not None:
                less_or_equal = value.le
            if value.multiple_of is not None:
                multiple_of = value.multiple_of
    return SchemaFloatConstraintsPayload(
        greater_than, greater_or_equal, less_than, less_or_equal, multiple_of
    )


@const_eval
def model_rules(metadata: list[SchemaShapeMetadata]) -> ModelRules:
    extra: str = "ignore"
    populate_by_name: bool = False
    location_by_alias: bool = True
    strict: bool = False
    validate_by_alias: bool = True
    alias_prefix: str = ""
    alias_case: str = "snake"
    for value in descriptor_values(metadata):
        if value.kind == "config":
            configured_extra: str | None = value.extra
            if configured_extra is not None:
                extra = configured_extra
            if extra != "ignore" and extra != "forbid":
                return ModelRules(
                    extra,
                    populate_by_name,
                    location_by_alias,
                    strict,
                    validate_by_alias,
                    alias_prefix,
                    alias_case,
                    "extra policy must be ignore or forbid",
                )
            populate_value: bool | None = value.populate_by_name
            if populate_value is not None:
                populate_by_name = populate_value
            location_value: bool | None = value.location_by_alias
            if location_value is not None:
                location_by_alias = location_value
            strict_value: bool | None = value.strict
            if strict_value is not None:
                strict = strict_value
            validate_value: bool | None = value.validate_by_alias
            if validate_value is not None:
                validate_by_alias = validate_value
            prefix_value: str | None = value.alias_prefix
            if prefix_value is not None:
                alias_prefix = prefix_value
            case_value: str | None = value.alias_case
            if case_value is not None:
                alias_case = case_value
    if not validate_by_alias and not populate_by_name:
        return ModelRules(
            extra,
            populate_by_name,
            location_by_alias,
            strict,
            validate_by_alias,
            alias_prefix,
            alias_case,
            "validate_by_alias and populate_by_name cannot both be disabled",
        )
    return ModelRules(
        extra,
        populate_by_name,
        location_by_alias,
        strict,
        validate_by_alias,
        alias_prefix,
        alias_case,
        None,
    )


@const_eval
def rebase_nodes(
    nodes: list[SchemaNodePayload], offset: int
) -> list[SchemaNodePayload]:
    output: list[SchemaNodePayload] = []
    for node in nodes:
        children: list[int] = []
        for child in node.children:
            children.append(child + offset)
        model: SchemaModelPayload | None = None
        node_model: SchemaModelPayload | None = node.model
        if node_model is None:
            model = None
        else:
            current_model: SchemaModelPayload = node_model
            fields: list[SchemaFieldPayload] = []
            for field in current_model.fields:
                fields.append(
                    SchemaFieldPayload(
                        field.name,
                        field.node + offset,
                        field.required,
                        field.default_kind,
                        field.default,
                        field.validation_aliases,
                        field.serialization_alias,
                        field.strict,
                        field.exclude,
                    )
                )
            model = SchemaModelPayload(
                current_model.name,
                current_model.identity,
                fields,
                current_model.extra,
                current_model.populate_by_name,
                current_model.location_by_alias,
                current_model.strict,
            )
        output.append(
            SchemaNodePayload(
                node.kind,
                children,
                node.definition,
                node.reference,
                node.error_code,
                node.error_message,
                model,
                node.integer_target,
                node.integer_constraints,
                node.float_constraints,
                node.string_constraints,
                node.bytes_constraints,
                node.collection_constraints,
                node.metadata,
                node.variants,
            )
        )
    return output


@const_eval
def build_node(
    node: SchemaShapeNode, inherited: list[SchemaShapeMetadata]
) -> NodeBuildResult:
    override: ErrorOverrideResult = error_override(inherited)
    if override.issue is not None:
        return NodeBuildResult([], 0, override.issue)
    rules: FieldRules = field_rules(inherited)
    if rules.issue is not None:
        return NodeBuildResult([], 0, rules.issue)
    if node.kind == "primitive" or node.kind == "fixed_integer":
        kind: str = "int"
        if node.kind == "primitive":
            kind = primitive_kind(node.name)
        if kind == "":
            return NodeBuildResult([], 0, "unsupported structural primitive")
        if sum_kind(kind, inherited) == "literal" and (
            has_integer_constraints(copy_metadata(inherited))
            or has_string_constraints(copy_metadata(inherited))
        ):
            return NodeBuildResult(
                [], 0, "field constraints are not supported for literal fields"
            )
        invalid_constraints: str | None = constraint_issue(
            kind, copy_metadata(inherited)
        )
        if invalid_constraints is not None:
            return NodeBuildResult([], 0, invalid_constraints)
        integer_target: str | None = None
        if kind == "int":
            if node.kind == "fixed_integer":
                integer_target = node.name
            else:
                integer_target = "int"
        leaf: SchemaNodePayload = SchemaNodePayload(
            sum_kind(kind, inherited),
            [],
            None,
            None,
            override.code,
            override.message,
            None,
            integer_target,
            rules.integer_constraints,
            float_constraints(inherited),
            rules.string_constraints,
            rules.bytes_constraints,
            rules.collection_constraints,
            runtime_metadata(inherited),
            [],
        )
        return NodeBuildResult([leaf], 0, None)
    if node.kind == "recursive_reference":
        if has_integer_constraints(copy_metadata(inherited)) or has_string_constraints(
            copy_metadata(inherited)
        ):
            return NodeBuildResult(
                [], 0, "field constraints are not supported for recursive references"
            )
        reference: SchemaNodePayload = SchemaNodePayload(
            "definition-ref",
            [],
            None,
            node.identity,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            runtime_metadata(inherited),
            [],
        )
        return NodeBuildResult([reference], 0, None)
    if node.kind == "list" or node.kind == "set" or node.kind == "optional":
        element: SchemaShapeNode | None = node.element
        if element is None:
            return NodeBuildResult([], 0, "unary schema node has no element")
        child_metadata: list[SchemaShapeMetadata] = []
        if node.kind == "optional":
            child_metadata = copy_metadata(inherited)
        else:
            collection_issue: str | None = constraint_issue(
                node.kind, copy_metadata(inherited)
            )
            if collection_issue is not None:
                return NodeBuildResult([], 0, collection_issue)
        built_element: NodeBuildResult = build_node(element, child_metadata)
        if built_element.issue is not None:
            return built_element
        unary_kind: str = "list"
        if node.kind == "set":
            unary_kind = "set"
        if node.kind == "optional":
            unary_kind = "nullable"
        unary: SchemaNodePayload = SchemaNodePayload(
            sum_kind(unary_kind, inherited),
            [built_element.root],
            None,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            None,
            None,
            rules.collection_constraints,
            runtime_metadata(inherited),
            [],
        )
        root: int = len(built_element.nodes)
        return NodeBuildResult(built_element.nodes + [unary], root, None)
    if node.kind == "dictionary":
        mapping_issue: str | None = constraint_issue(
            "dictionary", copy_metadata(inherited)
        )
        if mapping_issue is not None:
            return NodeBuildResult([], 0, mapping_issue)
        key: SchemaShapeNode | None = node.key
        value: SchemaShapeNode | None = node.value
        if key is None or value is None:
            return NodeBuildResult([], 0, "mapping schema node is incomplete")
        built_key: NodeBuildResult = build_node(key, [])
        if built_key.issue is not None:
            return built_key
        built_value: NodeBuildResult = build_node(value, [])
        if built_value.issue is not None:
            return built_value
        value_offset: int = len(built_key.nodes)
        nodes: list[SchemaNodePayload] = built_key.nodes + rebase_nodes(
            built_value.nodes,
            value_offset,
        )
        mapping: SchemaNodePayload = SchemaNodePayload(
            "dict",
            [built_key.root, built_value.root + value_offset],
            None,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            None,
            None,
            rules.collection_constraints,
            runtime_metadata(inherited),
            [],
        )
        root: int = len(nodes)
        return NodeBuildResult(nodes + [mapping], root, None)
    if node.kind == "tuple" or node.kind == "union":
        sequence_issue: str | None = None
        if node.kind == "union" and (
            has_integer_constraints(copy_metadata(inherited))
            or has_string_constraints(copy_metadata(inherited))
        ):
            sequence_issue = "field constraints are not supported for unions"
        if node.kind == "tuple":
            sequence_issue = constraint_issue("tuple", copy_metadata(inherited))
        if sequence_issue is not None:
            return NodeBuildResult([], 0, sequence_issue)
        member_nodes: list[SchemaNodePayload] = []
        member_roots: list[int] = []
        for member in node.members:
            built_member: NodeBuildResult = build_node(member, [])
            if built_member.issue is not None:
                return built_member
            offset: int = len(member_nodes)
            member_nodes = member_nodes + rebase_nodes(built_member.nodes, offset)
            member_roots.append(built_member.root + offset)
        sequence: SchemaNodePayload = SchemaNodePayload(
            sum_kind(node.kind, inherited),
            member_roots,
            None,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            None,
            None,
            rules.collection_constraints,
            runtime_metadata(inherited),
            [],
        )
        root: int = len(member_nodes)
        return NodeBuildResult(member_nodes + [sequence], root, None)
    if node.kind == "nominal":
        special_kind: str = ""
        if node.identity == "pydantic_sifr.special_values.Url":
            special_kind = "url"
        elif node.identity == "pydantic_sifr.special_values.MultiHostUrl":
            special_kind = "multi-host-url"
        elif node.identity == "pydantic_sifr.special_values.Pattern":
            special_kind = "pattern"
        if special_kind != "":
            if has_integer_constraints(
                copy_metadata(inherited)
            ) or has_string_constraints(copy_metadata(inherited)):
                return NodeBuildResult(
                    [], 0, "field constraints are not supported for specialized values"
                )
            specialized: SchemaNodePayload = SchemaNodePayload(
                special_kind,
                [],
                None,
                None,
                override.code,
                override.message,
                None,
                None,
                None,
                None,
                None,
                None,
                None,
                runtime_metadata(inherited),
                [],
            )
            return NodeBuildResult([specialized], 0, None)
        if has_integer_constraints(copy_metadata(inherited)) or has_string_constraints(
            copy_metadata(inherited)
        ):
            return NodeBuildResult(
                [], 0, "field constraints are not supported for model fields"
            )
        override = error_override(inherited + node.metadata)
        if override.issue is not None:
            return NodeBuildResult([], 0, override.issue)
        model_rules_value: ModelRules = model_rules(node.metadata)
        if model_rules_value.issue is not None:
            return NodeBuildResult([], 0, model_rules_value.issue)
        field_nodes: list[SchemaNodePayload] = []
        field_roots: list[int] = []
        model_fields: list[SchemaFieldPayload] = []
        for field in node.fields:
            repeated_definition: bool = False
            if field.type.kind == "nominal":
                for existing in field_nodes:
                    if existing.definition == field.type.identity + "":
                        repeated_definition = True
            built_field: NodeBuildResult = NodeBuildResult([], 0, None)
            if repeated_definition:
                field_override: ErrorOverrideResult = error_override(field.metadata)
                if field_override.issue is not None:
                    return NodeBuildResult([], 0, field_override.issue)
                reference_node: SchemaNodePayload = SchemaNodePayload(
                    "definition-ref",
                    [],
                    None,
                    field.type.identity + "",
                    field_override.code,
                    field_override.message,
                    None,
                    None,
                    None,
                    None,
                    None,
                    None,
                    None,
                    runtime_metadata(field.metadata),
                    [],
                )
                built_field = NodeBuildResult([reference_node], 0, None)
            else:
                built_field = build_node(field.type, field.metadata)
            if built_field.issue is not None:
                return built_field
            offset: int = len(field_nodes)
            field_nodes = field_nodes + rebase_nodes(built_field.nodes, offset)
            field_root: int = built_field.root + offset
            field_roots.append(field_root)
            field_rules_value: FieldRules = field_rules(field.metadata)
            if field_rules_value.issue is not None:
                return NodeBuildResult([], 0, field_rules_value.issue)
            validation_aliases: list[SchemaAliasPathPayload] = (
                field_rules_value.validation_aliases
            )
            serialization_alias: str | None = field_rules_value.serialization_alias
            if len(validation_aliases) == 0 and len(model_rules_value.alias_prefix) > 0:
                generated_alias: str = model_rules_value.alias_prefix + field.name
                generated_path: list[str | int] = []
                generated_path.append(generated_alias)
                validation_aliases.append(alias_path(generated_path))
                if serialization_alias is None:
                    serialization_alias = model_rules_value.alias_prefix + field.name
            if not model_rules_value.validate_by_alias:
                validation_aliases = []
            model_fields.append(
                SchemaFieldPayload(
                    field.name,
                    field_root,
                    field.required,
                    field.default_kind,
                    field.default,
                    validation_aliases,
                    serialization_alias,
                    field_rules_value.strict,
                    field_rules_value.exclude,
                )
            )
        model_payload: SchemaModelPayload = SchemaModelPayload(
            node.identity,
            node.identity,
            model_fields,
            model_rules_value.extra,
            model_rules_value.populate_by_name,
            model_rules_value.location_by_alias,
            model_rules_value.strict,
        )
        model_definition: str | None = node.identity
        model_value: SchemaModelPayload | None = model_payload
        model: SchemaNodePayload = SchemaNodePayload(
            "model",
            field_roots,
            model_definition,
            None,
            override.code,
            override.message,
            model_value,
            None,
            None,
            None,
            None,
            None,
            None,
            runtime_metadata(inherited + node.metadata),
            [],
        )
        root: int = len(field_nodes)
        return NodeBuildResult(field_nodes + [model], root, None)
    if node.kind == "enum":
        if has_integer_constraints(copy_metadata(inherited)) or has_string_constraints(
            copy_metadata(inherited)
        ):
            return NodeBuildResult(
                [], 0, "field constraints are not supported for enum fields"
            )
        override = error_override(inherited + node.metadata)
        if override.issue is not None:
            return NodeBuildResult([], 0, override.issue)
        enum_definition: str | None = node.identity
        enumeration: SchemaNodePayload = SchemaNodePayload(
            "enum",
            [],
            enum_definition,
            None,
            override.code,
            override.message,
            None,
            None,
            None,
            None,
            None,
            None,
            None,
            runtime_metadata(inherited + node.metadata),
            runtime_variants(node),
        )
        return NodeBuildResult([enumeration], 0, None)
    if node.kind == "newtype":
        return NodeBuildResult([], 0, "newtype schemas are not supported")
    return NodeBuildResult([], 0, "structural shape cannot form a schema program")


@const_eval
def expected_arity(kind: str) -> int:
    if kind == "list" or kind == "set" or kind == "nullable":
        return 1
    if kind == "dict":
        return 2
    if kind == "lax-or-strict" or kind == "json-or-structural":
        return 2
    if (
        kind == "model"
        or kind == "tuple"
        or kind == "union"
        or kind == "literal"
        or kind == "tagged-union"
        or kind == "chain"
    ):
        return -1
    return 0


@const_eval
def verify_nodes(nodes: list[SchemaNodePayload], root: int) -> str | None:
    count: int = len(nodes)
    if count == 0:
        return "schema program has no nodes"
    if count > 4096:
        return "schema program exceeds the static node limit"
    if root < 0 or root >= count:
        return "schema root is out of range"
    for node in nodes:
        arity: int = expected_arity(node.kind)
        if arity >= 0 and len(node.children) != arity:
            return "schema node has invalid child arity"
        if node.kind == "chain" and len(node.children) == 0:
            return "typed chain has no steps"
        for child in node.children:
            if child < 0 or child >= count:
                return "schema child index is out of range"
        if node.reference is not None and node.kind != "definition-ref":
            return "non-reference schema node has a reference"
        if node.kind == "definition-ref" and node.reference is None:
            return "definition reference has no identity"
        if node.kind == "model" and node.model is None:
            return "model schema node has no model payload"
        if node.error_code is None and node.error_message is not None:
            return "schema node has an error message without a code"
        if node.error_code is not None and node.error_message is None:
            return "schema node has an error code without a message"
    for left in nodes:
        if left.definition is not None:
            matches: int = 0
            for right in nodes:
                if right.definition == left.definition:
                    matches += 1
            if matches != 1:
                return "schema program has duplicate definition identities"
    for reference in nodes:
        if reference.reference is not None:
            found: bool = False
            for target in nodes:
                if target.definition == reference.reference:
                    found = True
            if not found:
                return "schema program has a dangling definition reference"
    return None


@const_eval
@metadata("sifr.meta.issue_template", ("schema_invalid", ["problem"]))
def verify_schema(shape: SchemaShapeInput) -> SchemaOutcome:
    built: NodeBuildResult = build_node(shape.root, [])
    build_issue: str | None = built.issue
    if build_issue is not None:
        return schema_failure(build_issue, shape.declaration.origin)
    problem: str | None = verify_nodes(built.nodes, built.root)
    if problem is not None:
        return schema_failure(problem, shape.declaration.origin)
    program: SchemaProgramPayload = SchemaProgramPayload(
        1,
        1,
        1,
        1,
        15,
        shape.canonical_identity,
        built.root,
        built.nodes,
    )
    return SchemaOutcome("produced", program, [])
