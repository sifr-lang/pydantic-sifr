from sifr.meta import Context, MethodSlots, StaticProgram, StringStructural, Structural
from sifr.json import JsonValue


class ValidationError(Error):
    message: str


class SerializationError(Error):
    message: str


class JsonSchemaError(Error):
    message: str


@rust.structural
@rust(bridge.model.validate)
def model_validate[T: StaticProgram, Input: Structural](
    payload: Input,
    strict: bool | None = None,
) -> Result[T, ValidationError | RustPanicError]: ...


@rust.structural
@rust(bridge.model.validate_json)
def model_validate_json[T: StaticProgram](
    payload: bytes,
    strict: bool | None = None,
) -> Result[T, ValidationError | RustPanicError]: ...


@rust.structural
@rust(bridge.model.validate_strings)
def model_validate_strings[T: StaticProgram, Input: StringStructural](
    payload: Input,
    strict: bool | None = None,
) -> Result[T, ValidationError | RustPanicError]: ...


@rust.structural
@rust(bridge.model.validate_with_validators)
# This path dispatches only the method slots sealed in the static program.
def model_validate_with_validators[T: MethodSlots, Input: Structural, C: Context](
    payload: Input, mut context: C, strict: bool | None = None
) -> Result[T, ValidationError | RustPanicError]: ...


@rust.structural
@rust(bridge.model.validate_json_with_validators)
def model_validate_json_with_validators[T: MethodSlots, C: Context](
    payload: bytes, mut context: C, strict: bool | None = None
) -> Result[T, ValidationError | RustPanicError]: ...


@rust.structural
@rust(bridge.model.validate_strings_with_validators)
def model_validate_strings_with_validators[
    T: MethodSlots,
    Input: StringStructural,
    C: Context,
](
    payload: Input, mut context: C, strict: bool | None = None
) -> Result[T, ValidationError | RustPanicError]: ...


@rust.structural
@rust(bridge.model.dump_json)
def model_dump_json[T: StaticProgram](
    value: T,
    include: list[str] | None = None,
    exclude: list[str] | None = None,
    by_alias: bool = False,
    exclude_none: bool = False,
    exclude_defaults: bool = False,
    integer_profile: str = "exact",
) -> Result[bytes, SerializationError | RustPanicError]: ...


@rust.structural
@rust(bridge.model.dump_json_with_serializers)
def model_dump_json_with_serializers[T: MethodSlots, C: Context](
    value: T,
    mut context: C,
    include: list[str] | None = None,
    exclude: list[str] | None = None,
    by_alias: bool = False,
    exclude_none: bool = False,
    exclude_defaults: bool = False,
    integer_profile: str = "exact",
) -> Result[bytes, SerializationError | RustPanicError]: ...


@rust.structural
@rust(bridge.model.dump)
def _model_dump_structural[T: StaticProgram, Output: Structural](
    value: T,
    include: list[str] | None = None,
    exclude: list[str] | None = None,
    by_alias: bool = False,
    exclude_none: bool = False,
    exclude_defaults: bool = False,
    integer_profile: str = "exact",
) -> Result[Output, SerializationError | RustPanicError]: ...


@rust.structural
@rust(bridge.model.dump_with_serializers)
def _model_dump_structural_with_serializers[
    T: MethodSlots,
    Output: Structural,
    C: Context,
](
    value: T,
    mut context: C,
    include: list[str] | None = None,
    exclude: list[str] | None = None,
    by_alias: bool = False,
    exclude_none: bool = False,
    exclude_defaults: bool = False,
    integer_profile: str = "exact",
) -> Result[Output, SerializationError | RustPanicError]: ...


def model_dump[T: StaticProgram](
    value: T,
    include: list[str] | None = None,
    exclude: list[str] | None = None,
    by_alias: bool = False,
    exclude_none: bool = False,
    exclude_defaults: bool = False,
    integer_profile: str = "exact",
) -> Result[dict[str, JsonValue], SerializationError | RustPanicError]:
    try:
        output: dict[str, JsonValue] = _model_dump_structural(
            value,
            include,
            exclude,
            by_alias,
            exclude_none,
            exclude_defaults,
            integer_profile,
        )
        return output
    except SerializationError as error:
        raise error
    except RustPanicError as error:
        raise error


def model_dump_with_serializers[T: MethodSlots, C: Context](
    value: T,
    mut context: C,
    include: list[str] | None = None,
    exclude: list[str] | None = None,
    by_alias: bool = False,
    exclude_none: bool = False,
    exclude_defaults: bool = False,
    integer_profile: str = "exact",
) -> Result[dict[str, JsonValue], SerializationError | RustPanicError]:
    try:
        output: dict[str, JsonValue] = _model_dump_structural_with_serializers(
            value,
            context,
            include,
            exclude,
            by_alias,
            exclude_none,
            exclude_defaults,
            integer_profile,
        )
        return output
    except SerializationError as error:
        raise error
    except RustPanicError as error:
        raise error
