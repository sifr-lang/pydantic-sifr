from .descriptors import AliasSelection
from .schema_constraints import descriptor_values
from .schema_types import FieldRules, ModelRules
from .schema_types import SchemaAliasPathPayload, SchemaAliasSegmentPayload
from .schema_types import SchemaBytesConstraintsPayload
from .schema_types import SchemaCollectionConstraintsPayload
from .schema_types import SchemaFloatConstraintsPayload
from .schema_types import SchemaIntegerConstraintsPayload
from .schema_types import SchemaShapeMetadata, SchemaShapeNode
from .schema_types import SchemaStringConstraintsPayload, SchemaVariantPayload


@const_eval
def alias_path(value: list[str | int]) -> SchemaAliasPathPayload:
    segments: list[SchemaAliasSegmentPayload] = []
    for segment in value:
        if isinstance(segment, str):
            segments.append(SchemaAliasSegmentPayload("field", segment, None))
        else:
            index: int = segment
            segments.append(SchemaAliasSegmentPayload("index", None, index))
    return SchemaAliasPathPayload(segments)


@const_eval
def alias_paths(value: AliasSelection | None) -> list[SchemaAliasPathPayload]:
    output: list[SchemaAliasPathPayload] = []
    if value is not None:
        for path in value.paths:
            output.append(alias_path(path))
    return output


@const_eval
def runtime_variants(node: SchemaShapeNode) -> list[SchemaVariantPayload]:
    output: list[SchemaVariantPayload] = []
    for variant in node.variants:
        output.append(SchemaVariantPayload(variant.name, variant.value, []))
    return output


@const_eval
def field_rules(metadata: list[SchemaShapeMetadata]) -> FieldRules:
    validation_aliases: list[SchemaAliasPathPayload] = []
    serialization_alias: str | None = None
    greater_than: int | float | None = None
    greater_or_equal: int | float | None = None
    less_than: int | float | None = None
    less_or_equal: int | float | None = None
    multiple_of: int | float | None = None
    min_length: int | None = None
    max_length: int | None = None
    pattern: str | None = None
    strip_whitespace: bool = False
    to_lower: bool = False
    to_upper: bool = False
    ascii_only: bool = False
    strict: bool | None = None
    exclude: bool = False
    for value in descriptor_values(metadata):
        if value.kind == "field":
            selected_aliases: list[SchemaAliasPathPayload] = alias_paths(
                value.validation_alias
            )
            direct_alias: str | None = value.alias
            has_direct_alias: bool = direct_alias is not None
            direct_path: SchemaAliasPathPayload = SchemaAliasPathPayload(
                [SchemaAliasSegmentPayload("field", direct_alias, None)]
            )
            if len(selected_aliases) == 0 and has_direct_alias:
                selected_aliases.append(direct_path)
            if len(selected_aliases) > 0:
                validation_aliases = selected_aliases
            selected_serialization_alias: str | None = value.serialization_alias
            if selected_serialization_alias is None:
                selected_serialization_alias = value.alias
            if selected_serialization_alias is not None:
                serialization_alias = selected_serialization_alias
            if value.gt is not None:
                greater_than = value.gt
            if value.ge is not None:
                greater_or_equal = value.ge
            if value.lt is not None:
                less_than = value.lt
            if value.le is not None:
                less_or_equal = value.le
            if value.multiple_of is not None:
                multiple_of = value.multiple_of
            if value.min_length is not None:
                min_length = value.min_length
            if value.max_length is not None:
                max_length = value.max_length
            if value.pattern is not None:
                pattern = value.pattern
            strip_value: bool | None = value.strip_whitespace
            if strip_value is not None:
                strip_whitespace = strip_value
            lower_value: bool | None = value.to_lower
            if lower_value is not None:
                to_lower = lower_value
            upper_value: bool | None = value.to_upper
            if upper_value is not None:
                to_upper = upper_value
            ascii_value: bool | None = value.ascii_only
            if ascii_value is not None:
                ascii_only = ascii_value
            strict_value: bool | None = value.strict
            if strict_value is not None:
                strict = strict_value
            exclude_value: bool | None = value.exclude
            if exclude_value is not None:
                exclude = exclude_value
    if min_length is not None and max_length is not None:
        minimum: int = min_length
        maximum: int = max_length
        if minimum > maximum:
            return empty_field_rules(
                "min_length cannot exceed max_length after descriptor merge"
            )
    if to_lower and to_upper:
        return empty_field_rules("to_lower and to_upper cannot both be enabled")
    return FieldRules(
        validation_aliases,
        serialization_alias,
        SchemaIntegerConstraintsPayload(
            greater_than, greater_or_equal, less_than, less_or_equal, multiple_of
        ),
        SchemaStringConstraintsPayload(
            min_length,
            max_length,
            strip_whitespace,
            to_lower,
            to_upper,
            ascii_only,
            pattern,
        ),
        SchemaBytesConstraintsPayload(min_length, max_length),
        SchemaCollectionConstraintsPayload(min_length, max_length),
        strict,
        exclude,
        None,
    )


@const_eval
def empty_field_rules(problem: str) -> FieldRules:
    return FieldRules(
        [],
        None,
        SchemaIntegerConstraintsPayload(None, None, None, None, None),
        SchemaStringConstraintsPayload(None, None, False, False, False, False, None),
        SchemaBytesConstraintsPayload(None, None),
        SchemaCollectionConstraintsPayload(None, None),
        None,
        False,
        problem,
    )


@const_eval
def float_constraints(
    metadata: list[SchemaShapeMetadata],
) -> SchemaFloatConstraintsPayload:
    greater_than: int | float | None = None
    greater_or_equal: int | float | None = None
    less_than: int | float | None = None
    less_or_equal: int | float | None = None
    multiple_of: int | float | None = None
    for value in descriptor_values(metadata):
        if value.kind == "field":
            if value.gt is not None:
                greater_than = value.gt
            if value.ge is not None:
                greater_or_equal = value.ge
            if value.lt is not None:
                less_than = value.lt
            if value.le is not None:
                less_or_equal = value.le
            if value.multiple_of is not None:
                multiple_of = value.multiple_of
    return SchemaFloatConstraintsPayload(
        greater_than, greater_or_equal, less_than, less_or_equal, multiple_of
    )


@const_eval
def model_rules(metadata: list[SchemaShapeMetadata]) -> ModelRules:
    extra: str = "ignore"
    populate_by_name: bool = False
    location_by_alias: bool = True
    strict: bool = False
    validate_by_alias: bool = True
    alias_prefix: str = ""
    alias_case: str = "snake"
    for value in descriptor_values(metadata):
        if value.kind == "config":
            configured_extra: str | None = value.extra
            if configured_extra is not None:
                extra = configured_extra
            if extra != "ignore" and extra != "forbid":
                return ModelRules(
                    extra,
                    populate_by_name,
                    location_by_alias,
                    strict,
                    validate_by_alias,
                    alias_prefix,
                    alias_case,
                    "extra policy must be ignore or forbid",
                )
            populate_value: bool | None = value.populate_by_name
            if populate_value is not None:
                populate_by_name = populate_value
            location_value: bool | None = value.location_by_alias
            if location_value is not None:
                location_by_alias = location_value
            strict_value: bool | None = value.strict
            if strict_value is not None:
                strict = strict_value
            validate_value: bool | None = value.validate_by_alias
            if validate_value is not None:
                validate_by_alias = validate_value
            prefix_value: str | None = value.alias_prefix
            if prefix_value is not None:
                alias_prefix = prefix_value
            case_value: str | None = value.alias_case
            if case_value is not None:
                alias_case = case_value
    if not validate_by_alias and not populate_by_name:
        return ModelRules(
            extra,
            populate_by_name,
            location_by_alias,
            strict,
            validate_by_alias,
            alias_prefix,
            alias_case,
            "validate_by_alias and populate_by_name cannot both be disabled",
        )
    return ModelRules(
        extra,
        populate_by_name,
        location_by_alias,
        strict,
        validate_by_alias,
        alias_prefix,
        alias_case,
        None,
    )
