@attached_api(
    "pydantic_sifr.api",
    "PydanticPlainModelApi",
    public_name="model_json_schema",
    receiver="type",
    owner="T",
)
@rust.structural
@rust(bridge.model.json_schema)
def attached_plain_model_json_schema[T: StaticProgram](
    serialization: bool = False,
    by_alias: bool = True,
    integer_profile: str = "exact",
) -> Result[bytes, JsonSchemaError | RustPanicError]: ...


