from sifr.json import JsonValue
from sifr.meta import (
    Context,
    MethodSlots,
    NoContext,
    StaticProgram,
    StringStructural,
    Structural,
)
from .model import JsonSchemaError, SerializationError, ValidationError
from .model import model_dump as dump_model
from .model import model_dump_json as dump_model_json
from .model import model_dump_json_with_serializers
from .model import model_dump_with_serializers
from .model import model_validate as validate_model
from .model import model_validate_json as validate_model_json
from .model import model_validate_json_with_validators
from .model import model_validate_strings as validate_model_strings
from .model import model_validate_strings_with_validators
from .model import model_validate_with_validators


@attached_api_set
class PydanticModelApi:
    pass


@attached_api_set
class PydanticPlainModelApi:
    pass


@attached_api(
    "pydantic_sifr.api",
    "PydanticPlainModelApi",
    public_name="model_validate",
    receiver="type",
    owner="T",
)
def attached_plain_model_validate[T: StaticProgram, Input: Structural](
    payload: Input,
    strict: bool | None = None,
) -> Result[T, ValidationError | RustPanicError]:
    return validate_model(payload, strict)


@attached_api(
    "pydantic_sifr.api",
    "PydanticPlainModelApi",
    public_name="model_validate_json",
    receiver="type",
    owner="T",
)
def attached_plain_model_validate_json[T: StaticProgram](
    payload: bytes,
    strict: bool | None = None,
) -> Result[T, ValidationError | RustPanicError]:
    return validate_model_json(payload, strict)


@attached_api(
    "pydantic_sifr.api",
