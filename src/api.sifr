from sifr.json import JsonValue
from sifr.meta import Context, MethodSlots, NoContext, StaticProgram
from .model import SerializationError
from .model import model_dump as dump_model
from .model import model_dump_json as dump_model_json
from .model import model_dump_json_with_serializers
from .model import model_dump_with_serializers


@attached_api_set
class PydanticModelApi:
    pass


@attached_api_set
class PydanticPlainModelApi:
    pass


@attached_api(
    "pydantic_sifr.api",
    "PydanticPlainModelApi",
    public_name="model_dump",
    receiver="immutable",
    owner="T",
)
def attached_plain_model_dump[T: StaticProgram](
    target: Self,
) -> Result[dict[str, JsonValue], SerializationError | RustPanicError]:
    return dump_model(target)


@attached_api(
    "pydantic_sifr.api",
    "PydanticPlainModelApi",
    public_name="model_dump_json",
    receiver="immutable",
    owner="T",
)
def attached_plain_model_dump_json[T: StaticProgram](
    target: Self,
) -> Result[bytes, SerializationError | RustPanicError]:
    return dump_model_json(target)


@attached_api(
    "pydantic_sifr.api",
    "PydanticPlainModelApi",
    public_name="model_dump_options",
    receiver="immutable",
    owner="T",
)
def attached_plain_model_dump_options[T: StaticProgram](
    target: Self,
    include: list[str] | None,
    exclude: list[str] | None,
    by_alias: bool,
    exclude_none: bool,
    exclude_defaults: bool,
) -> Result[dict[str, JsonValue], SerializationError | RustPanicError]:
    return dump_model(
        target,
        include,
        exclude,
        by_alias,
        exclude_none,
        exclude_defaults,
    )


@attached_api(
    "pydantic_sifr.api",
