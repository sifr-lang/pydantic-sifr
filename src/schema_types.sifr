from .errors import SchemaIssue
from sifr.meta import CallableIdentity, ClassDeclaration, SourceOrigin

from .descriptors import PydanticDescriptor


class SchemaShapeMetadata:
    key: str
    value_type: str
    value: PydanticDescriptor


class SchemaMetadataPayload:
    key: str
    value: str


class SchemaShapeField:
    name: str
    type: SchemaShapeNode
    required: bool
    default_kind: str
    default: bool | int | float | str | bytes | None
    default_factory: CallableIdentity | None
    metadata: list[SchemaShapeMetadata]


class SchemaShapeVariant:
    name: str
    value: int | None
    metadata: list[SchemaShapeMetadata]


class SchemaShapeParameter:
    name: str
    type: SchemaShapeNode
    convention: str
    keyword_only: bool
    metadata: list[SchemaShapeMetadata]


class SchemaShapeMethod:
    target: CallableIdentity | None
    descriptor: PydanticDescriptor | None
    origin: SourceOrigin | None
    declaration_order: int | None
    name: str
    kind: str
    receiver: str | None
    is_async: bool
    params: list[SchemaShapeParameter]
    result: SchemaShapeNode
    output: SchemaShapeNode
    fallible: bool
    metadata: list[SchemaShapeMetadata]


class SchemaVariantPayload:
    name: str
    value: int | None
    metadata: list[SchemaMetadataPayload]


class SchemaShapeNode:
    kind: str
    name: str
    identity: str
    element: SchemaShapeNode | None
    key: SchemaShapeNode | None
    value: SchemaShapeNode | None
    members: list[SchemaShapeNode]
    type_arguments: list[SchemaShapeNode]
    fields: list[SchemaShapeField]
    methods: list[SchemaShapeMethod]
    metadata: list[SchemaShapeMetadata]
    variants: list[SchemaShapeVariant]
    inner: SchemaShapeNode | None


class SchemaShapeInput:
    canonical_identity: str
    root: SchemaShapeNode
    declaration: ClassDeclaration


class SchemaAliasSegmentPayload:
    kind: str
    name: str | None
    index: int | None


class SchemaAliasPathPayload:
    segments: list[SchemaAliasSegmentPayload]


class SchemaFieldPayload:
    name: str
    node: int
    required: bool
    default_kind: str
    default: bool | int | float | str | bytes | None
    validation_aliases: list[SchemaAliasPathPayload]
    serialization_alias: str | None
    strict: bool | None
    exclude: bool


class SchemaModelPayload:
    name: str
    identity: str
    fields: list[SchemaFieldPayload]
    extra: str
    populate_by_name: bool
    location_by_alias: bool
    strict: bool


class SchemaIntegerConstraintsPayload:
    greater_than: int | float | None
    greater_or_equal: int | float | None
    less_than: int | float | None
    less_or_equal: int | float | None
    multiple_of: int | float | None


class SchemaStringConstraintsPayload:
    min_length: int | None
    max_length: int | None
    strip_whitespace: bool
    to_lower: bool
    to_upper: bool
    ascii_only: bool
    pattern: str | None


class SchemaFloatConstraintsPayload:
    greater_than: int | float | None
    greater_or_equal: int | float | None
    less_than: int | float | None
    less_or_equal: int | float | None
    multiple_of: int | float | None


class SchemaBytesConstraintsPayload:
    min_length: int | None
    max_length: int | None


class SchemaCollectionConstraintsPayload:
    min_length: int | None
    max_length: int | None


class SchemaNodePayload:
    kind: str
    children: list[int]
    definition: str | None
    reference: str | None
    error_code: str | None
    error_message: str | None
    model: SchemaModelPayload | None
    integer_target: str | None
    integer_constraints: SchemaIntegerConstraintsPayload | None
    float_constraints: SchemaFloatConstraintsPayload | None
    string_constraints: SchemaStringConstraintsPayload | None
    bytes_constraints: SchemaBytesConstraintsPayload | None
    collection_constraints: SchemaCollectionConstraintsPayload | None
    metadata: list[SchemaMetadataPayload]
    variants: list[SchemaVariantPayload]
    validator_slot: int | None = None
    validator_target: str | None = None


class SchemaValidatorPayload:
    slot: int
    kind: str
    mode: str
    targets: list[str]


class SchemaSerializerPayload:
    slot: int
    kind: str
    target: str
    when_used: str
    takes_receiver: bool
    output: int
    alias: str | None


class SchemaProgramPayload:
    schema_program_version: int
    structural_contract_version: int
    structural_call_version: int
    callback_abi_version: int
    feature_bitmap: int
    canonical_shape_identity: str
    root: int
    nodes: list[SchemaNodePayload]
    sifr_method_slots: list[CallableIdentity] = []
    validators: list[SchemaValidatorPayload] = []
    serializers: list[SchemaSerializerPayload] = []


class SchemaOutcome:
    status: str
    value: SchemaProgramPayload | None
    issues: list[SchemaIssue]


class ErrorOverrideResult:
    code: str | None
    message: str | None
    issue: str | None


class NodeBuildResult:
    nodes: list[SchemaNodePayload]
    root: int
    issue: str | None


class FieldRules:
    validation_aliases: list[SchemaAliasPathPayload]
    serialization_alias: str | None
    integer_constraints: SchemaIntegerConstraintsPayload
    string_constraints: SchemaStringConstraintsPayload
    bytes_constraints: SchemaBytesConstraintsPayload
    collection_constraints: SchemaCollectionConstraintsPayload
    strict: bool | None
    exclude: bool
    issue: str | None


class ModelRules:
    extra: str
    populate_by_name: bool
    location_by_alias: bool
    strict: bool
    validate_by_alias: bool
    alias_prefix: str
    alias_case: str
    issue: str | None
