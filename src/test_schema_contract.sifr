from .schema_contract import verify_schema


@const_specialize("schema_contract", "verify_schema")
@metadata("field", "value", "pydantic.error.package", "example")
@metadata("field", "value", "pydantic.error.code", "positive")
@metadata("field", "value", "pydantic.error.message", "Must be positive")
class SchemaContractProbe:
    value: int


def test_static_schema_contract() -> None:
    probe: SchemaContractProbe = SchemaContractProbe(1)
    assert probe.value == 1
