@method_descriptor("pydantic_sifr.declarations", "adapt_model")
def field_serializer(
    field: str,
    additional_fields: list[str] | None = None,
    when_used: str = "always",
) -> PydanticDescriptor:
    fields: list[str] = [field]
    if additional_fields is not None:
        for target in additional_fields:
            fields.append(target)
    return PydanticDescriptor(
        "field-serializer",
        "required",
        serializer_fields=fields,
        serializer_when_used=when_used,
    )


